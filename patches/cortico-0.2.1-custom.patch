+/** Persona context panel: live capacity, retention policy, and saved handoff notes. */
+import type { WebUiPanel, WebUiPanelContext } from 'cortico/web/shared/client-panel.ts';
+import type { ContextConsoleState } from '../persona/context-console.ts';
+import './context.css';
+
+const labels: Record<string, string> = { system: '系统前缀', reasoning: '历史推理', tools: '工具调用与结果', dialogue: '对话与事件' };
+const number = (value: number | null): string => value === null ? '未知' : Math.round(value).toLocaleString();
+export function renderContext(ctx: WebUiPanelContext, st: ContextConsoleState, phase: string | null, reload: () => void): HTMLElement {
+  const { ui } = ctx;
+  const root = ui.h('div', 'ct-context');
+  const soft = Math.round(st.policy.maxTokens * st.policy.softRatio);
+  const limit = st.hardTokens === null ? st.policy.maxTokens : Math.min(st.policy.maxTokens, st.hardTokens);
+  const warned = st.currentTokens !== null && st.currentTokens >= soft;
+  const title = ui.rowbar();
+  title.append(ui.h('h2', null, '上下文'), ui.h('span', 'grow'), ui.pill(
+    !st.attached ? '尚未连接 Core' : phase === 'handoff' ? '交接中' : st.pressureWarned ? '已提醒保存记忆' : warned ? '达到预警线' : phase === null ? '实时阶段未知' : '正常',
+    !st.attached ? 'off' : phase === 'handoff' || warned || phase === null ? 'plain' : 'on'),
+    ui.button('刷新', { size: 'sm', onClick: reload }));
+  root.append(title);
+  if (st.observationWarning) root.append(ui.h('p', 'ct-context-error', st.observationWarning));
+  const capacity = ui.sheet({ title: '当前容量', desc: '下一次模型请求的输入量；上游计数与新增内容估算结合，不代表累计账单。' });
+  capacity.body.append(ui.h('p', 'ct-context-reading', `${number(st.currentTokens)} / ${number(limit)} tok`));
+  const track = ui.h('div', 'ct-context-track');
+  track.setAttribute('role', 'meter');
+  track.setAttribute('aria-label', '当前上下文占用');
+  track.setAttribute('aria-valuemin', '0'); track.setAttribute('aria-valuemax', String(limit));
+  if (st.currentTokens !== null) track.setAttribute('aria-valuenow', String(Math.min(limit, st.currentTokens)));
+  else track.setAttribute('aria-valuetext', '未知');
+  const fill = ui.h('span', 'ct-context-fill');
+  fill.style.width = `${Math.max(0, Math.min(100, (st.currentTokens ?? 0) / limit * 100))}%`;
+  if (warned) fill.classList.add('ct-context-pressure');
+  track.append(fill);
+  const marker = ui.h('span', 'ct-context-marker'); marker.style.left = `${Math.min(100, soft / limit * 100)}%`;
+  marker.title = `预警线 ${number(soft)} tok`; track.append(marker);
+  capacity.body.append(track, ui.kv([
+    { k: '自动交接', v: `预警线 ${number(soft)} tok；提醒后的下一批仍超出时交接` },
+    { k: '阶段预算', v: `${number(st.policy.maxTokens)} tok` },
+    { k: '模型输入硬上限', v: `${number(st.hardTokens)}${st.hardTokens === null ? '' : ' tok'}` },
+    { k: '交接笔记预算', v: `${number(st.policy.maxTokens * st.policy.keepRatio)} tok` },
+  ]), ui.h('p', 'ct-dim', '阈值在 Persona → 配置中调整。交接笔记保留近期内容，历史按年龄折叠；长期记忆文件跨交接保留。'));
+  root.append(capacity.el);
+  const composition = ui.sheet({ title: '内容构成', desc: '按当前消息本地估算；不含请求独立携带的工具定义，不能与上游总数逐项对账。' });
+  const total = st.categories.reduce((sum, row) => sum + row.tokens, 0);
+  if (!total) composition.body.append(ui.placeholder('当前还没有可分类的消息。'));
+  for (const row of st.categories) {
+    const line = ui.h('div', 'ct-context-category');
+    line.append(ui.h('span', null, labels[row.name] ?? row.name));
+    const bar = ui.h('div', 'ct-context-track'); const value = ui.h('span', 'ct-context-fill');
+    value.style.width = `${row.tokens / total * 100}%`; bar.append(value);
+    line.append(bar, ui.h('span', 'ct-context-value', `≈ ${number(row.tokens)} tok`));
+    composition.body.append(line);
+  }
+  root.append(composition.el);
+  const history = ui.sheet({ title: '交接记录', desc: '最近 30 份已保存的交接笔记。安装前的记录只显示文件信息；交接前输入与笔记大小不能换算为实际费用节省。' });
+  if (!st.handoffs.length) history.body.append(ui.placeholder('还没有交接记录；自动交接后会出现在这里。'));
+  for (const row of st.handoffs) {
+    const line = ui.h('div', 'ct-context-history');
+    const text = ui.h('div');
+    text.append(ui.h('strong', null, new Date(row.at).toLocaleString(ctx.language === 'en' ? 'en-US' : 'zh-CN')));
+    text.append(ui.h('div', 'ct-dim', row.metric
+      ? `交接前 ${number(row.metric.beforeTokens)} tok → 笔记 ≈ ${number(row.metric.noteTokens)} tok · 收录 ${row.metric.entries} 条 · 预算外省略 ${row.metric.dropped} 条`
+      : `历史笔记 · ${number(row.bytes)} 字节 · 当时的 token 统计未记录`));
+    const open = ui.button('查看笔记', { size: 'sm', onClick: () => {
+      open.disabled = true;
+      void ctx.invoke<{ content: string }>('note', [row.file]).then(result => {
+        if (ctx.signal.aborted) return;
+        const pre = ui.h('pre', 'ct-context-note', result.content);
+        ui.drawer('交接笔记', pre);
+      }).catch((error: unknown) => { if (!ctx.signal.aborted) ui.toast(`读取失败：${String(error)}`, 'bad'); })
+        .finally(() => { open.disabled = false; });
+    } });
+    line.append(text, open); history.body.append(line);
+  }
+  root.append(history.el);
+  return root;
+}
+
+export const contextPanel: WebUiPanel = {
+  mount(ctx) {
+    let busy = false;
+    let last: ContextConsoleState | null = null;
+    let rendered = '';
+    const error = ctx.ui.h('div', 'ct-context-error'); error.setAttribute('role', 'status');
+    const host = ctx.ui.h('div'); ctx.root.append(error, host);
+    host.append(ctx.ui.placeholder('正在读取上下文…'));
+    const load = async (): Promise<void> => {
+      if (busy || ctx.signal.aborted) return;
+      busy = true;
+      try {
+        const state = await ctx.invoke<ContextConsoleState>('state');
+        let phase: string | null = null;
+        try {
+          const response = await fetch('/api/status', { signal: AbortSignal.any([ctx.signal, AbortSignal.timeout(5000)]) }); // arch-allow: host run phase has no panel invoke endpoint; read-only request is bounded and aborted on unmount.
+          if (response.ok) { const status = await response.json(); phase = status.loop?.phase?.state ?? null; }
+        } catch { /* Capacity and notes remain available when live phase is unavailable. */ }
+        if (ctx.signal.aborted) return;
+        last = state; error.textContent = '';
+        const signature = JSON.stringify([state, phase]);
+        if (signature !== rendered) {
+          rendered = signature;
+          host.replaceChildren(renderContext(ctx, state, phase, () => { void load(); }));
+        }
+      } catch (err) {
+        if (!ctx.signal.aborted) {
+          error.textContent = `更新失败：${String(err)}。${last ? '下方为上次数据。' : '请刷新重试。'}`;
+          if (!last) host.replaceChildren(ctx.ui.button('重试', { onClick: () => { void load(); } }));
+        }
+      } finally { busy = false; }
+    };
+    void load();
+    ctx.interval(() => { if (!ctx.root.ownerDocument.hidden) void load(); }, 3000);
+  },
+};
