+        total > 0 ? `合计 ${num(total)} 条` : '—',
+      ]);
+
+      for (const scope of state.scopes) {
+        modelTable.addRow([scope.run === null ? scope.label : `${scope.label} ${scope.run}`, modelText(scope.models)]);
