+/**
+ * 时间线面板的服务端数据面：只读当前 run 的日志，把投影结果交给面板。
+ *
+ * 适配层以 .mjs 交付（安装到本文件旁的 `usage/`），这里用**运行时**动态 import 加载它：
+ * 那些 .mjs 没有类型标注，静态 import 会把它们拉进 tsc 的文件表并触发一批
+ * `implicitly has an any type`，typecheck 会因此变红。
+ *
+ * 只读 `<dataDir>/runs/<当前 run>/toolcalls.jsonl` 与 `log.jsonl`，
+ * 路径不由调用方给出；首次读整个文件，之后按字节游标增量读，游标留在进程里。
+ */
+
+import { dirname, join } from 'node:path';
+import { fileURLToPath, pathToFileURL } from 'node:url';
+
+/** 安装后的适配层入口。 */
+const MODULE_PATH = join(dirname(fileURLToPath(import.meta.url)), 'usage', 'timeline-state.mjs');
+
+export interface TimelinePanelOptions {
+  /** 注入「现在」；只给测试用。 */
+  now?: string | number | Date;
+  refreshTtlMs?: number;
+  maxEntries?: number;
+  pageSize?: number;
+  detailChars?: number;
+  timezone?: string;
+}
+
+interface TimelineStateModule {
+  timelineState(dataDir: string, options?: TimelinePanelOptions): Promise<unknown>;
+}
+
+let loading: Promise<TimelineStateModule> | null = null;
+
+function loadAdapter(): Promise<TimelineStateModule> {
+  if (loading === null) {
+    loading = (async () => {
+      try {
+        return (await import(pathToFileURL(MODULE_PATH).href)) as TimelineStateModule;
+      } catch (error) {
+        loading = null;
+        throw new Error(
+          `时间线面板适配层未安装或加载失败：${MODULE_PATH}（${error instanceof Error ? error.message : String(error)}）`,
+        );
+      }
+    })();
+  }
+  return loading;
+}
+
+/** 面板的 `state` 方法实现。首次读会扫一遍现有字节，之后每次只读新增。 */
+export class TimelineConsole {
+  constructor(
+    private readonly dataDir: string,
+    private readonly timezone: string,
+  ) {}
+
+  async state(options?: TimelinePanelOptions): Promise<unknown> {
+    const adapter = await loadAdapter();
+    return adapter.timelineState(this.dataDir, { timezone: this.timezone, ...options });
+  }
+}
