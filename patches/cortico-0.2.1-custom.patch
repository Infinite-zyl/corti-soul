diff --git a/src/worlds/minecraft/reconnect-budget.ts b/src/worlds/minecraft/reconnect-budget.ts
new file mode 100644
index 0000000..d79703c
--- /dev/null
+++ b/src/worlds/minecraft/reconnect-budget.ts
@@ -0,0 +1,224 @@
+/**
+ * 自动重连的预算与退避。
+ *
+ * 一次连接稳定成功才清零；失败按退避阶梯排下一次尝试，预算用满之后不再排，
+ * 进入「已暂停」等用户明确恢复。预算只在明确的新一轮开始时清零——用户点启动或重试。
+ * 心跳、重复的服务器就绪回报、模型反复调用失败的工具都不清零。
+ */
+
+export interface ReconnectBudgetOptions {
+  /** 一次成功连接之后最多自动重试几次。0 = 一次都不自动重试。 */
+  maxRetries: number;
+  /** 第一次重试前等多少秒。 */
+  baseDelaySec: number;
+  /** 单次等待的上限秒数。 */
+  maxDelaySec: number;
+  /**
+   * 连接要保持这么久才算「稳定在线」，才允许清零预算。
+   *
+   * spawn 成功只说明握手过了：服务器能立刻踢人、也能连上就断。拿 spawn 当成功
+   * 会让「连上即断」的抖动每次刷新预算，预算永远用不完——正是要止住的那种。
+   */
+  stableSec: number;
+}
+
+export const RECONNECT_BUDGET_DEFAULTS: ReconnectBudgetOptions = {
+  maxRetries: 3,
+  baseDelaySec: 10,
+  maxDelaySec: 60,
+  stableSec: 60,
+};
+
+/** 退避阶梯的倍数：10s / 30s / 60s（封顶）。 */
+const BACKOFF_FACTOR = 3;
+
+/** `ready` = 预算可用；`waiting` = 已排下一次尝试；`paused` = 预算用满，等用户明确恢复。 */
+export type ReconnectPhase = 'ready' | 'waiting' | 'paused';
+
+/**
+ * 明确不可重试的原因：认证失败、协议版本对不上、被封禁。
+ * 命中就一次都不重试，直接暂停——反复试只会反复唤醒主模型。
+ */
+const PERMANENT_PATTERNS: ReadonlyArray<RegExp> = [
+  /unsupported protocol/i,
+  /incorrect protocol/i,
+  /protocol version/i,
+  /incompatible/i,
+  /invalid credentials/i,
+  /failed to (?:verify|authenticate)/i,
+  /authentication/i,
+  /multiplayer\.disconnect\.(?:banned|not_whitelisted|incompatible|unsupported|invalid)/i,
+];
+
+/** 这个断线原因是不是明确不可重试。 */
+export function isPermanentFailure(reason: string): boolean {
+  return PERMANENT_PATTERNS.some((re) => re.test(reason));
+}
+
+/** 把配置夹到可用范围：非法值退回默认，不让一份坏配置把预算关掉。 */
+function normalize(raw: Partial<ReconnectBudgetOptions> | undefined): ReconnectBudgetOptions {
+  const int = (value: unknown, fallback: number, min: number): number =>
+    typeof value === 'number' && Number.isFinite(value) && value >= min ? Math.floor(value) : fallback;
+  const maxRetries = int(raw?.maxRetries, RECONNECT_BUDGET_DEFAULTS.maxRetries, 0);
+  const baseDelaySec = int(raw?.baseDelaySec, RECONNECT_BUDGET_DEFAULTS.baseDelaySec, 1);
+  const maxDelaySec = int(raw?.maxDelaySec, RECONNECT_BUDGET_DEFAULTS.maxDelaySec, 1);
+  const stableSec = int(raw?.stableSec, RECONNECT_BUDGET_DEFAULTS.stableSec, 0);
+  return { maxRetries, baseDelaySec, maxDelaySec: Math.max(baseDelaySec, maxDelaySec), stableSec };
+}
+
+/** 暂停时交给 World 的一次性说明。 */
+export interface ReconnectPauseInfo {
+  /** 最后一次失败的原因原文。 */
+  reason: string;
+  /** 明确不可重试（认证、版本）时为真，而不是预算用满。 */
+  permanent: boolean;
+  /** 已经用掉几次自动重试。 */
+  retries: number;
+  /** 还剩几次；暂停后为 0。 */
+  remaining: number;
+  /** 最近一次成功连接的时刻（毫秒）；从没连上过为 null。 */
+  lastSuccessAtMs: number | null;
+}
+
+export class ReconnectBudget {
+  private used = 0;
+  private phaseValue: ReconnectPhase = 'ready';
+  private lastSuccessAtMsValue: number | null = null;
+  private lastFailureAtMsValue: number | null = null;
+  private lastReasonValue = '';
+  /** 当前这条连接握手成功的时刻；没连上为 null。 */
+  private upSinceMsValue: number | null = null;
+  /**
+   * 当前这条连接是否已经确认过稳定。
+   *
+   * 稳定是**每条连接一次的状态转换**，不是每秒都成立的一个条件。心跳每秒问一次，
+   * 如果每次都回 true，调用方就会每秒重放一遍「刚刚稳定」的副作用（写日志、清暂停），
+   * 而且 `lastSuccessAtMs` 会被刷成「现在」而不是真正的稳定时刻。这里记住已经确认过，
+   * 后续调用返回 false，而 `isStable` / `stable` 仍然如实反映「当前确实稳定在线」。
+   */
+  private stableConfirmedValue = false;
+
+  constructor(private readonly options: () => Partial<ReconnectBudgetOptions> | undefined) {}
+
+  get phase(): ReconnectPhase {
+    return this.phaseValue;
+  }
+
+  /** 这一次成功连接之后已经自动重试了几次。 */
+  get usedRetries(): number {
+    return this.used;
+  }
+
+  /** 还剩几次自动重试；暂停后为 0。 */
+  get remaining(): number {
+    return Math.max(0, normalize(this.options()).maxRetries - this.used);
+  }
+
+  get lastSuccessAtMs(): number | null {
+    return this.lastSuccessAtMsValue;
+  }
+
+  get lastFailureAtMs(): number | null {
+    return this.lastFailureAtMsValue;
+  }
+
+  /** 最近一次失败的原因原文，用于暂停时的说明。 */
+  get lastReason(): string {
+    return this.lastReasonValue;
+  }
+
+  /** 当前连接已经在线多久（毫秒）；没连上为 null。 */
+  uptimeMs(nowMs: number): number | null {
+    return this.upSinceMsValue === null ? null : Math.max(0, nowMs - this.upSinceMsValue);
+  }
+
+  /** 当前这条连接是否已经算稳定在线。 */
+  isStable(nowMs: number): boolean {
+    const opts = normalize(this.options());
+    const up = this.uptimeMs(nowMs);
+    return up !== null && up >= opts.stableSec * 1000;
+  }
+
+  /** 当前这一次尝试的退避秒数；只在下一次尝试存在时有意义。 */
+  delaySecFor(used: number): number {
+    const opts = normalize(this.options());
+    return Math.min(opts.maxDelaySec, opts.baseDelaySec * BACKOFF_FACTOR ** used);
+  }
+
+  /**
+   * 一条连接握手成功（mineflayer 的 spawn）。
+   *
+   * **不清零预算**：spawn 只说明握手过了，服务器可以立刻踢人、也可以连上就断。
+   * 拿它当成功，会让「连上即断」的抖动每次刷新预算。稳定由 `confirmStable` 判定。
+   */
+  connected(nowMs: number): void {
+    this.upSinceMsValue = nowMs;
+    this.stableConfirmedValue = false;
+  }
+
+  /** 连接断了：稳定窗口作废，下一次 spawn 重新计时。 */
+  disconnected(): void {
+    this.upSinceMsValue = null;
+    this.stableConfirmedValue = false;
+  }
+
+  /**
+   * 检查当前连接是否刚刚达到稳定在线满 `stableSec`。
+   *
+   * 这是**每条连接一次的状态转换**：第一次问且已满则清零预算、离开暂停、记下最后成功
+   * 时间并返回 true；之后同一条连接再问一律返回 false，且**不再改写 `lastSuccessAtMs`**。
+   * 需要「当前是否稳定」的调用方请用 `isStable`——它不受这条一次性约束影响。
+   *
+   * 连接断开、握手重来或明确恢复（`resume`）都会复位这个一次性标志，所以重连之后
+   * 可以再次成功确认一次；而「连上 5 秒又断」永远走不到这里，预算刷不回来。
+   */
+  confirmStable(nowMs: number): boolean {
+    if (this.stableConfirmedValue || !this.isStable(nowMs)) return false;
+    this.stableConfirmedValue = true;
+    this.used = 0;
+    this.phaseValue = 'ready';
+    this.lastSuccessAtMsValue = nowMs;
+    return true;
+  }
+
+  /**
+   * 记一次失败，返回下一次尝试前要等的毫秒数。
+   *
+   * 预算已用满、或原因是明确不可重试时返回 null 并进入 `paused`——
+   * 调用方据此清掉计时器、停止重连。
+   */
+  failed(reason: string, nowMs: number): number | null {
+    this.lastFailureAtMsValue = nowMs;
+    this.lastReasonValue = reason;
+    this.upSinceMsValue = null;
+    // 连接已经结束，这条连接的一次性稳定确认随之作废：重连之后要能重新确认一次。
+    this.stableConfirmedValue = false;
+    if (isPermanentFailure(reason) || this.used >= normalize(this.options()).maxRetries) {
+      this.phaseValue = 'paused';
+      return null;
+    }
+    const delaySec = this.delaySecFor(this.used);
+    this.used += 1;
+    this.phaseValue = 'waiting';
+    return delaySec * 1000;
+  }
+
+  /** 明确的新一轮（用户点启动或重试）：预算清零并离开暂停，不改最后成功时间。 */
+  resume(): void {
+    this.used = 0;
+    this.phaseValue = 'ready';
+    this.upSinceMsValue = null;
+    this.stableConfirmedValue = false;
+  }
+
+  /** 暂停说明。 */
+  pauseInfo(): ReconnectPauseInfo {
+    return {
+      reason: this.lastReasonValue,
+      permanent: isPermanentFailure(this.lastReasonValue),
+      retries: this.used,
+      remaining: this.remaining,
+      lastSuccessAtMs: this.lastSuccessAtMsValue,
+    };
+  }
+}
