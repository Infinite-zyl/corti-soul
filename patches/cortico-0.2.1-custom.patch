+/**
+ * 用量面板的服务端数据面：只读部署数据目录，把聚合结果投影成面板形状。
+ *
+ * 适配层以 .mjs 交付（安装到本文件旁的 `usage/`），这里用**运行时**动态 import 加载它：
+ * 那些 .mjs 没有类型标注，静态 import 会把它们拉进 tsc 的文件表并触发一批
+ * `implicitly has an any type`，typecheck 会因此变红。
+ *
+ * 只读 `<dataDir>/usage.jsonl` 与 `<dataDir>/runs/<run>/toolcalls.jsonl`，
+ * 路径不由调用方给出；首次按时间范围读，之后按字节游标增量读，游标留在进程里。
+ */
+
+import { dirname, join } from 'node:path';
+import { fileURLToPath, pathToFileURL } from 'node:url';
+
+/** 安装后的适配层入口。 */
+const MODULE_PATH = join(dirname(fileURLToPath(import.meta.url)), 'usage', 'panel-state.mjs');
+
+export interface UsagePanelOptions {
+  /** 注入「现在」；只给测试用。 */
+  now?: string | number | Date;
+  sinceDays?: number;
+  refreshTtlMs?: number;
+  maxRoundDetails?: number;
+  timezone?: string;
+}
+
+interface PanelStateModule {
+  panelState(dataDir: string, options?: UsagePanelOptions): Promise<unknown>;
+}
+
+let loading: Promise<PanelStateModule> | null = null;
+
+function loadAdapter(): Promise<PanelStateModule> {
+  if (loading === null) {
+    loading = (async () => {
+      try {
+        return (await import(pathToFileURL(MODULE_PATH).href)) as PanelStateModule;
+      } catch (error) {
+        loading = null;
+        throw new Error(
+          `用量面板适配层未安装或加载失败：${MODULE_PATH}（${error instanceof Error ? error.message : String(error)}）`,
+        );
+      }
+    })();
+  }
+  return loading;
+}
+
+/** 面板的 `state` 方法实现。首次读会扫一遍现有字节，之后每次只读新增。 */
+export class UsageConsole {
+  constructor(
+    private readonly dataDir: string,
+    private readonly timezone: string,
+  ) {}
+
+  async state(options?: UsagePanelOptions): Promise<unknown> {
+    const adapter = await loadAdapter();
+    return adapter.panelState(this.dataDir, { timezone: this.timezone, ...options });
+  }
+}
