+/**
+ * 当前 run 的动作时间线。
+ *
+ * 两个来源：`toolcalls.jsonl` 里 `mc_` 工具的调用（模型下过的令）与 `log.jsonl` 里
+ * 执行器边界事件（enqueue / start / begin / done / blocked / aborted / cancelled /
+ * skip / noop / cleared / precheck / suspend / preempted）。两个来源分开标注，
+ * 一次队列不代表队列里每一步都已经成功。
+ *
+ * 执行器步骤按调用 ID + 任务号 + 步骤参数配对，不按名字去重：同一条 `mc_do` 里重复的
+ * `goto` 是两次动作，两次 `mc_do` 里的同一个 `goto` 也是两次动作。有 `begin` 而没有
+ * 配对到终结事件的步骤计为**未结束**，不推断成成功。
+ *
+ * 投影只保留动作白名单字段、截断到首行的结果与原因。工具参数原文、回执全文、QQ 正文
+ * 与密钥不进返回值：`args` 只按白名单取键，`receipt` 只取首个非空行并截断。
+ */
+
+import { readdir } from 'node:fs/promises';
+import { join, resolve, sep } from 'node:path';
+import { JsonlFileState } from './incremental.mjs';
+import { RUNS_DIRNAME, TOOLCALLS_FILENAME } from './source.mjs';
+import { isMinecraftTool } from './types.mjs';
+
+/** 时间线最多保留最近多少条。 */
+export const TIMELINE_MAX_ENTRIES = 500;
+/** 时间线每页条数。 */
+export const TIMELINE_PAGE_SIZE = 25;
+/** 单条 `detail` 最多多少字符。 */
+export const TIMELINE_DETAIL_CHARS = 160;
+
+/**
+ * 进时间线的执行器事件。
+ *
+ * 只收任务与步骤的边界：投递、开工、每步开始与结局、叫停、预检。`goal` / `reached` /
+ * `gain` / `spectate` / `place-confirmed` 这类逐帧过程不进时间线。
+ */
+export const TIMELINE_EVENTS = new Set([
+  'enqueue', 'start', 'begin', 'done', 'blocked', 'aborted', 'cancelled',
+  'skip', 'noop', 'cleared', 'precheck', 'suspend', 'preempted',
+]);
+
+/** 步骤级终结事件。 */
+const TERMINAL_EVENTS = new Set(['done', 'blocked', 'aborted', 'skip', 'noop']);
+
+/** 事件的阶段名。 */
+const PHASE_OF = {
+  enqueue: 'queued',
+  start: 'started',
+  begin: 'begin',
+  done: 'done',
+  blocked: 'blocked',
+  aborted: 'aborted',
+  cancelled: 'cancelled',
+  skip: 'skipped',
+  noop: 'noop',
+  cleared: 'cleared',
+  precheck: 'precheck',
+  suspend: 'suspended',
+  preempted: 'preempted',
+};
+
+/** 事件的结局状态。`begin` 的结局由配对决定，这里不给。 */
+const STATUS_OF = {
+  enqueue: 'queued',
+  start: 'started',
+  done: 'ok',
+  blocked: 'blocked',
+  aborted: 'aborted',
+  cancelled: 'cancelled',
+  skip: 'skipped',
+  noop: 'noop',
+  cleared: 'cleared',
+  precheck: 'precheck',
+  suspend: 'suspended',
+  preempted: 'preempted',
+};
+
+/** 步骤参数里允许出现在摘要中的键。 */
+export const STEP_FIELDS = [
+  'skill', 'block', 'item', 'target', 'count', 'distance', 'direction',
+  'name', 'at', 'shape', 'anchors', 'material', 'grid', 'groundY',
+];
+
+const SKILL_ZH = {
+  collect: '采集', craft: '合成', eat: '吃', find: '找', goto: '去', attack: '打',
+  pickup: '捡', take: '取', use: '用', stow: '收', surface: '上地面', probe: '探查',
+  tunnel: '挖通道', flee: '远离', goto_player: '去玩家', fish: '钓鱼', build: '搭',
+  equip: '装备', place: '放置', dig: '挖', mine: '挖', sleep: '睡', drop: '丢',
+};
+
+const NAME_ZH = {
+  oak_log: '橡木原木', birch_log: '白桦原木', oak_planks: '橡木木板',
+  crafting_table: '工作台', stick: '木棍', wooden_pickaxe: '木镐', wooden_sword: '木剑',
+  dirt: '泥土', apple: '苹果', beef: '牛肉', mutton: '羊肉', cow: '牛', sheep: '羊',
+  pig: '猪', chicken: '鸡', iron_helmet: '铁头盔', torch: '火把',
+  cobblestone: '圆石', salmon: '鲑鱼', fishing_rod: '钓鱼竿',
+};
+
+const DIRECTION_ZH = { east: '东', west: '西', north: '北', south: '南', up: '上', down: '下' };
+
+function zh(name) {
+  return NAME_ZH[name] ?? name;
+}
+
+function fmtPoint(at) {
+  if (!Array.isArray(at) || at.length === 0) return '';
+  return `(${at.map((value) => String(value)).join(',')})`;
+}
+
+/** 一个步骤参数 → 一句结构化摘要。只读白名单字段，其余键一律忽略。 */
+export function stepText(step) {
+  if (step === null || typeof step !== 'object' || Array.isArray(step)) return '';
+  const skill = typeof step.skill === 'string' ? step.skill : '';
+  const verb = SKILL_ZH[skill] ?? skill;
+  const parts = [];
+  if (verb !== '') parts.push(verb);
+  const what = typeof step.block === 'string' ? zh(step.block)
+    : typeof step.item === 'string' ? zh(step.item)
+      : typeof step.target === 'string' ? zh(step.target)
+        : typeof step.name === 'string' ? step.name
+          : typeof step.material === 'string' ? zh(step.material)
+            : '';
+  if (what !== '') parts.push(what);
+  if (typeof step.count === 'number' && Number.isFinite(step.count)) parts.push(`×${step.count}`);
+  const at = fmtPoint(step.at);
+  if (at !== '') parts.push(at);
+  const anchors = Array.isArray(step.anchors) && step.anchors.length > 0
+    ? step.anchors.map((point) => fmtPoint(point)).join('→')
+    : '';
+  if (anchors !== '') parts.push(anchors);
+  if (typeof step.distance === 'number' && Number.isFinite(step.distance)) parts.push(`${step.distance} 格内`);
+  if (typeof step.direction === 'string' && step.direction !== '') {
+    parts.push(DIRECTION_ZH[step.direction] ?? step.direction);
+  }
+  if (typeof step.shape === 'string' && step.shape !== '') parts.push(step.shape);
+  return parts.join(' ').trim();
+}
+
+/** 一组步骤 → `{ text, steps, more }`；`text` 是最多前 4 步的摘要。 */
+export function summarizeSteps(steps, options = {}) {
+  const max = options.max ?? 4;
+  if (!Array.isArray(steps) || steps.length === 0) return { text: '', steps: [], more: 0 };
+  const projected = steps.map((step) => stepText(step)).filter((text) => text !== '');
+  const shown = projected.slice(0, max);
+  const more = Math.max(0, projected.length - shown.length);
+  return {
+    text: shown.join('；') + (more > 0 ? `；…另 ${more} 步` : ''),
+    steps: shown,
+    more,
+  };
+}
+
+/** 取首个非空行并截断；`detail` 只用来回答「结果如何」。 */
+export function firstLine(text, max = TIMELINE_DETAIL_CHARS) {
+  if (typeof text !== 'string' || text === '') return '';
+  for (const raw of text.split('\n')) {
+    const line = raw.replace(/\r/g, '').trim();
+    if (line === '') continue;
+    return line.length > max ? `${line.slice(0, max)}…` : line;
+  }
+  return '';
+}
+
+/** 工具调用里允许进摘要的 args：只认 steps，别的键（text/content/to/path…）一律不读。 */
+function stepsOfArgs(args) {
+  if (args === null || typeof args !== 'object' || Array.isArray(args)) return null;
+  return Array.isArray(args.steps) ? args.steps : null;
+}
+
+/**
+ * `toolcalls.jsonl` 的一行 → 时间线条目；不是 Minecraft 工具时返回 null。
+ *
+ * 状态固定为 `call`：这一行只证明模型下过这条令，不证明它成功。结局由执行器事件回答。
+ */
+export function projectToolCall(raw, options = {}) {
+  if (raw === null || typeof raw !== 'object') return null;
+  if (!isMinecraftTool(raw)) return null;
+  const tool = typeof raw.tool === 'string' ? raw.tool : '';
+  const steps = stepsOfArgs(raw.args);
+  const summary = steps === null ? { text: '', more: 0 } : summarizeSteps(steps);
+  return {
+    key: `tool|${raw.seq ?? ''}|${raw.call ?? ''}`,
+    at: typeof raw.ts === 'string' ? raw.ts : '',
+    seq: typeof raw.seq === 'number' ? raw.seq : null,
+    run: typeof raw.run === 'string' ? raw.run : '',
+    round: typeof raw.round === 'number' ? raw.round : null,
+    source: 'tool',
+    scope: 'call',
+    tool,
+    event: '',
+    phase: 'call',
+    status: 'call',
+    taskId: null,
+    stepIndex: null,
+    action: summary.text,
+    detail: firstLine(raw.receipt, options.detailChars ?? TIMELINE_DETAIL_CHARS),
+    durMs: typeof raw.durMs === 'number' ? raw.durMs : null,
+    callId: typeof raw.call === 'string' ? raw.call : '',
+    actionKey: summary.text,
+    unfinished: false,
+  };
+}
+
+function projectLandings(landings) {
+  if (!Array.isArray(landings) || landings.length === 0) return '';
+  const parts = landings.slice(0, 2).map((item) => {
+    if (item === null || typeof item !== 'object') return '';
+    const step = typeof item.step === 'number' ? `第 ${item.step} 步` : '';
+    const outcome = typeof item.outcome === 'string' ? item.outcome : '';
+    const why = typeof item.why === 'string' ? firstLine(item.why, 40) : '';
+    return [step, outcome, why].filter((part) => part !== '').join(' ');
+  });
+  const text = parts.filter((part) => part !== '').join('；');
+  return landings.length > 2 ? `${text}；…另 ${landings.length - 2} 步` : text;
+}
+
+function projectHits(hits) {
+  if (!Array.isArray(hits) || hits.length === 0) return '';
+  const parts = hits.slice(0, 2).map((hit) => {
+    if (hit === null || typeof hit !== 'object') return '';
+    const level = typeof hit.level === 'string' ? hit.level : '';
+    const text = typeof hit.text === 'string' ? firstLine(hit.text, 48) : '';
+    return [level, text].filter((part) => part !== '').join(' ');
+  });
+  const text = parts.filter((part) => part !== '').join('；');
+  return hits.length > 2 ? `${text}；…另 ${hits.length - 2} 条` : text;
+}
+
+function projectEnqueueDetail(data) {
+  const parts = [];
+  if (typeof data.mode === 'string' && data.mode !== '') {
+    parts.push(data.mode === 'replace' ? '换掉手上这单' : `模式 ${data.mode}`);
+  }
+  if (typeof data.ahead === 'number' && Number.isFinite(data.ahead)) parts.push(`前面还有 ${data.ahead} 单`);
+  if (Array.isArray(data.dropped) && data.dropped.length > 0) parts.push(`丢下 ${data.dropped.length} 步`);
+  if (data.cut !== null && data.cut !== undefined) parts.push('裁掉了超出的一截');
+  return parts.join('，');
+}
+
+function projectEventDetail(event, data) {
+  switch (event) {
+    case 'enqueue':
+      return projectEnqueueDetail(data);
+    case 'start':
+      return typeof data.waiting === 'number' ? `前面还等着 ${data.waiting} 单` : '';
+    case 'done':
+      return firstLine(typeof data.result === 'string' ? data.result : '');
+    case 'blocked':
+      return [firstLine(typeof data.error === 'string' ? data.error : ''),
+        typeof data.source === 'string' && data.source !== '' ? `（${data.source}）` : ''].join('');
+    case 'aborted':
+      return [firstLine(typeof data.error === 'string' ? data.error : ''),
+        typeof data.by === 'string' && data.by !== '' ? `（由 ${data.by}）` : ''].join('');
+    case 'cancelled':
+      return [typeof data.by === 'string' ? data.by : '', projectLandings(data.landings)]
+        .filter((part) => part !== '').join('：');
+    case 'skip':
+      return [
+        Array.isArray(data.needs) ? `差 ${data.needs.length} 步` : '',
+        Array.isArray(data.causal) && data.causal.length > 0 ? `根因 ${data.causal.slice(0, 2).map((v) => zh(String(v))).join('、')}` : '',
+      ].filter((part) => part !== '').join('，');
+    case 'noop':
+      return firstLine(typeof data.why === 'string' ? data.why : '');
+    case 'cleared':
+      return Array.isArray(data.dropped) ? `丢掉 ${data.dropped.length} 步` : '';
+    case 'precheck':
+      return projectHits(data.hits);
+    default:
+      return '';
+  }
+}
+
+/**
+ * `log.jsonl` 的一行 → 时间线条目；不是执行器边界事件时返回 null。
+ *
+ * `scope` 区分任务级与步骤级：带 `data.call` 的 `done` / `blocked` 是某一步的结局，
+ * 不带的是整单的汇总。
+ */
+export function projectExecutorEvent(raw, options = {}) {
+  if (raw === null || typeof raw !== 'object') return null;
+  // 别的 area 也有同名事件（core.loop 的 start/done），时间线只认执行器那一支。
+  if (raw.area !== 'worlds.minecraft') return null;
+  const event = typeof raw.event === 'string' ? raw.event : '';
+  if (!TIMELINE_EVENTS.has(event)) return null;
+  const data = raw.data !== null && typeof raw.data === 'object' ? raw.data : {};
+  const step = data.call !== null && typeof data.call === 'object' && !Array.isArray(data.call) ? data.call : null;
+  const steps = Array.isArray(data.steps) ? data.steps : null;
+  const summary = steps === null ? null : summarizeSteps(steps);
+  const action = step !== null ? stepText(step) : (summary === null ? '' : summary.text);
+  const detail = projectEventDetail(event, data);
+  const detailChars = options.detailChars ?? TIMELINE_DETAIL_CHARS;
+  return {
+    key: `exec|${raw.seq ?? ''}|${event}`,
+    at: typeof raw.ts === 'string' ? raw.ts : '',
+    seq: typeof raw.seq === 'number' ? raw.seq : null,
+    run: typeof raw.run === 'string' ? raw.run : '',
+    round: typeof raw.round === 'number' ? raw.round : null,
+    source: 'executor',
+    scope: step !== null ? 'step' : 'task',
+    tool: '',
+    event,
+    phase: PHASE_OF[event] ?? event,
+    status: STATUS_OF[event] ?? 'unknown',
+    taskId: typeof raw.task === 'number' ? raw.task : null,
+    stepIndex: null,
+    action,
+    detail: detail.length > detailChars ? `${detail.slice(0, detailChars)}…` : detail,
+    durMs: typeof raw.durMs === 'number' ? raw.durMs : null,
+    callId: typeof raw.call === 'string' ? raw.call : '',
+    actionKey: step === null ? '' : JSON.stringify(step),
+    unfinished: false,
+  };
+}
+
+function compareAsc(a, b) {
+  if (a.at !== b.at) return a.at < b.at ? -1 : 1;
+  return (a.seq ?? 0) - (b.seq ?? 0);
+}
+
+function compareDesc(a, b) {
+  return compareAsc(b, a);
+}
+
+/**
+ * 把 `begin` 与步骤级终结事件配对。
+ *
+ * 键是调用 ID + 任务号 + 步骤参数 JSON：同一条 `mc_do` 里的两个 `goto` 是两个键相同的
+ * 独立动作，所以按键排队、按出现顺序各配一次。配不到的 `begin` 记 `unfinished`。
+ */
+export function pairSteps(entries) {
+  const queues = new Map();
+  const ordered = [...entries].sort(compareAsc);
+  for (const entry of ordered) {
+    if (entry.source !== 'executor') continue;
+    const key = `${entry.callId}\u0000${entry.taskId ?? ''}\u0000${entry.actionKey}`;
+    if (entry.event === 'begin') {
+      if (!queues.has(key)) queues.set(key, []);
+      queues.get(key).push(entry);
+      continue;
+    }
+    if (!TERMINAL_EVENTS.has(entry.event) || entry.scope !== 'step') continue;
+    const queue = queues.get(key);
+    if (queue === undefined || queue.length === 0) continue;
+    const begin = queue.shift();
+    begin.status = 'started';
+    begin.detail = entry.detail === '' ? '已结束' : `已结束：${entry.detail}`;
+    entry.stepIndex = begin.stepIndex;
+  }
+  let unfinished = 0;
+  for (const queue of queues.values()) {
+    for (const begin of queue) {
+      begin.unfinished = true;
+      begin.status = 'unfinished';
+      begin.detail = begin.detail === '' ? '没有结束事件，算未结束' : `没有结束事件：${begin.detail}`;
+      unfinished += 1;
+    }
+  }
+  return unfinished;
+}
+
+function countBy(items, pick) {
+  const counts = new Map();
+  for (const item of items) {
+    const key = pick(item);
+    counts.set(key, (counts.get(key) ?? 0) + 1);
+  }
+  return counts;
+}
+
+function topEntries(counts, limit) {
+  return [...counts].sort((a, b) => b[1] - a[1] || String(a[0]).localeCompare(String(b[0])))
+    .slice(0, limit)
+    .map(([key, count]) => ({ key, count }));
+}
+
+/**
+ * 组出当前 run 的时间线与统计。
+ *
+ * 统计口径是**完整当前 run**（内存里累积的全部投影条目），不是列表那 500 条；
+ * 列表只保留最近 `maxEntries` 条，未展示的数量在 `omitted` 里如实给出。
+ *
+ * @param {object} input `{ run, toolCalls, events }`
+ * @param {object} [options] `{ maxEntries, pageSize, detailChars, repeatLimit }`
+ */
+export function buildTimeline(input, options = {}) {
+  const run = typeof input.run === 'string' ? input.run : '';
+  const maxEntries = options.maxEntries ?? TIMELINE_MAX_ENTRIES;
+  const pageSize = options.pageSize ?? TIMELINE_PAGE_SIZE;
+  const repeatLimit = options.repeatLimit ?? 10;
+  const detailChars = options.detailChars ?? TIMELINE_DETAIL_CHARS;
+
+  const entries = [];
+  const toolEntries = [];
+  const seenTools = new Set();
+  const repeatKeys = new Map();
+  for (const raw of input.toolCalls ?? []) {
+    const entry = projectToolCall(raw, { detailChars });
+    if (entry === null) continue;
+    const id = entry.callId === '' ? null : `${entry.run}\u0000${entry.callId}`;
+    if (id !== null && seenTools.has(id)) continue;
+    if (id !== null) seenTools.add(id);
+    entries.push(entry);
+    toolEntries.push(entry);
+    repeatKeys.set(entry, JSON.stringify(raw.args ?? null));
+  }
+  const execEntries = [];
+  for (const raw of input.events ?? []) {
+    const entry = projectExecutorEvent(raw, { detailChars });
+    if (entry === null) continue;
+    entries.push(entry);
+    execEntries.push(entry);
+  }
+
+  const unfinished = pairSteps(entries);
+
+  const stepEvents = execEntries.filter((entry) => entry.scope === 'step');
+  const taskEvents = execEntries.filter((entry) => entry.scope === 'task');
+  const endCounts = countBy(stepEvents.filter((entry) => TERMINAL_EVENTS.has(entry.event)), (entry) => entry.event);
+  const taskCounts = countBy(taskEvents, (entry) => entry.event);
+  const toolCounts = countBy(toolEntries, (entry) => entry.tool);
+
+  const repeatCounts = new Map();
+  for (const entry of toolEntries) {
+    const key = `${entry.tool}\u0000${entry.action}\u0000${repeatKeys.get(entry)}`;
+    repeatCounts.set(key, (repeatCounts.get(key) ?? 0) + 1);
+  }
+  const repeats = [...repeatCounts]
+    .filter(([, count]) => count > 1)
+    .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
+    .slice(0, repeatLimit)
+    .map(([key, count]) => {
+      const [tool, action] = key.split('\u0000');
+      return { tool, action, count };
+    });
+
+  const newestFirst = [...entries].sort(compareDesc);
+  const shown = newestFirst.slice(0, maxEntries);
+
+  return {
+    run,
+    entries: shown,
+    /** 因超出上限未展示的条数；为 0 时说明列表覆盖了整个 run。 */
+    omitted: Math.max(0, newestFirst.length - shown.length),
+    total: newestFirst.length,
+    maxEntries,
+    pageSize,
+    newestFirst: true,
+    stats: {
+      scope: 'current-run',
+      run,
+      toolCalls: {
+        total: toolEntries.length,
+        byTool: topEntries(toolCounts, 12).map((item) => ({ tool: item.key, count: item.count })),
+      },
+      steps: {
+        begin: stepEvents.filter((entry) => entry.event === 'begin').length,
+        ok: endCounts.get('done') ?? 0,
+        blocked: endCounts.get('blocked') ?? 0,
+        aborted: endCounts.get('aborted') ?? 0,
+        cancelled: endCounts.get('cancelled') ?? 0,
+        skipped: endCounts.get('skip') ?? 0,
+        noop: endCounts.get('noop') ?? 0,
+        unfinished,
+      },
+      taskEvents: {
+        enqueue: taskCounts.get('enqueue') ?? 0,
+        start: taskCounts.get('start') ?? 0,
+        done: taskCounts.get('done') ?? 0,
+        blocked: taskCounts.get('blocked') ?? 0,
+        cancelled: taskCounts.get('cancelled') ?? 0,
+        cleared: taskCounts.get('cleared') ?? 0,
+        suspended: (taskCounts.get('suspend') ?? 0) + (taskCounts.get('preempted') ?? 0),
+        precheck: taskCounts.get('precheck') ?? 0,
+      },
+      repeats,
+    },
+  };
+}
+
+/** 当前 run 的执行器日志文件名。 */
+export const LOG_FILENAME = 'log.jsonl';
+
+/**
+ * 当前 run 的增量读取器。
+ *
+ * 只读 `<dataDir>/runs/<当前 run>/` 下的 `toolcalls.jsonl` 与 `log.jsonl` 两个文件：
+ * 当前 run 取 run 目录名的字典序最大值（run 名以时间戳开头）。换 run 时旧游标与旧条目
+ * 全部作废、从头读新 run；同一次运行内只读新增字节，不重扫已经读过的部分。
+ *
+ * `toolcalls.jsonl` 保留原文（时间线要读 `args.steps` 才能给出动作摘要，而
+ * `types.mjs` 的投影会把 `args` 丢掉）；`log.jsonl` 只留执行器边界事件。
+ */
+export class TimelineSource {
+  /**
+   * @param {string} dataDir 部署数据目录
+   */
+  constructor(dataDir) {
+    this.dataDir = resolve(dataDir);
+    this.runsDir = join(this.dataDir, RUNS_DIRNAME);
+    /** 当前 run 名；空串表示还没读到 run。 */
+    this.run = '';
+    this.toolcallState = null;
+    this.logState = null;
+    /** 当前 run 的原始工具调用行。 */
+    this.toolCalls = [];
+    /** 当前 run 里通过事件白名单的原始日志行。 */
+    this.events = [];
+    this.anomalies = {
+      missingRunsDir: false,
+      missingLog: false,
+      missingToolCalls: false,
+      /** 不是执行器边界事件、被挡在时间线之外的日志行数。 */
+      skippedEvents: 0,
+    };
+    this.lastRefreshRead = { run: '', toolCalls: 0, events: 0, rebuilds: 0 };
+  }
+
+  /** run 名 → 该 run 目录下的文件名；名字越界时返回 null。 */
+  runPathFor(runName, filename) {
+    if (typeof runName !== 'string' || runName === '' || runName === '.' || runName === '..') return null;
+    if (runName.includes('/') || runName.includes('\\')) return null;
+    const path = resolve(this.runsDir, runName, filename);
+    return path.startsWith(this.runsDir + sep) ? path : null;
+  }
+
+  /** run 目录名的字典序最大值；读不到目录时返回空串。 */
+  async currentRun() {
+    let names;
+    try {
+      names = await readdir(this.runsDir, { withFileTypes: true });
+    } catch (error) {
+      if (error !== null && typeof error === 'object' && error.code === 'ENOENT') {
+        this.anomalies.missingRunsDir = true;
+        return '';
+      }
+      throw error;
+    }
+    this.anomalies.missingRunsDir = false;
+    return names
+      .filter((item) => item.isDirectory())
+      .map((item) => item.name)
+      .sort()
+      .at(-1) ?? '';
+  }
+
+  /**
+   * 读一次新增字节。
+   *
+   * @returns {Promise<{run: string, toolCalls: number, events: number, rebuilds: number}>} 本次真正读到的条数
+   */
+  async refresh() {
+    const read = { run: this.run, toolCalls: 0, events: 0, rebuilds: 0 };
+    const run = await this.currentRun();
+    if (run !== this.run) {
+      // 换了 run：上一个 run 的游标与条目都不能再用。
+      this.run = run;
+      const toolcallPath = run === '' ? null : this.runPathFor(run, TOOLCALLS_FILENAME);
+      const logPath = run === '' ? null : this.runPathFor(run, LOG_FILENAME);
+      this.toolcallState = toolcallPath === null ? null : new JsonlFileState(toolcallPath);
+      this.logState = logPath === null ? null : new JsonlFileState(logPath);
+      this.toolCalls = [];
+      this.events = [];
+      read.rebuilds += 1;
+    }
+    read.run = this.run;
+    if (this.toolcallState === null || this.logState === null) {
+      this.lastRefreshRead = read;
+      return read;
+    }
+
+    const calls = await this.toolcallState.read();
+    if (this.toolcallState.lastReadReset) {
+      this.toolCalls = [];
+      read.rebuilds += 1;
+    }
+    for (const entry of calls) this.toolCalls.push(entry);
+    read.toolCalls = calls.length;
+    this.anomalies.missingToolCalls = this.toolcallState.anomalies.missing === true;
+
+    const lines = await this.logState.read();
+    if (this.logState.lastReadReset) {
+      this.events = [];
+      read.rebuilds += 1;
+    }
+    for (const line of lines) {
+      const event = line !== null && typeof line === 'object' ? line.event : undefined;
+      if (typeof event !== 'string' || !TIMELINE_EVENTS.has(event)) {
+        this.anomalies.skippedEvents += 1;
+        continue;
+      }
+      this.events.push(line);
+      read.events += 1;
+    }
+    this.anomalies.missingLog = this.logState.anomalies.missing === true;
+
+    this.lastRefreshRead = read;
+    return read;
+  }
+
+  /** 读到的坏行、截断与缺失；面板用它如实报数据源状态。 */
+  get anomalySummary() {
+    return {
+      ...this.anomalies,
+      badLines: (this.toolcallState?.anomalies.badLines ?? 0) + (this.logState?.anomalies.badLines ?? 0),
+      truncations: (this.toolcallState?.anomalies.truncations ?? 0) + (this.logState?.anomalies.truncations ?? 0),
+    };
+  }
+}
