+        const pageCount = Math.max(1, Math.ceil(list.length / size));
+        // 轮次变少（日志重建、窗口变化）时把页码夹回有效范围，不留在空白页上。
+        if (page > pageCount) page = pageCount;
+        if (page < 1) page = 1;
+        const from = (page - 1) * size;
+        const rows = list.slice(from, from + size);
+        for (const row of rows) {
+          roundTable.addRow([
+            row.run ?? '—',
+            row.round === null ? '—' : String(row.round),
+            row.role ?? '—',
+            row.categoryLabel,
+            num(row.attempts),
+            num(row.input),
+            num(row.cached),
+            num(row.uncached),
+            num(row.output),
+            num(row.reasoning),
+            num(row.unknownCache),
+            num(row.failed),
+            modelText(row.models),
+            { text: row.cacheReconciled ? '✓' : '未知或对不上', cls: row.cacheReconciled ? 'mono' : 'txt' },
+            row.lastTs ?? '—',
+          ]);
+        }
+        roundBar.hidden = false;
+        btnPrev.disabled = page <= 1;
+        btnNext.disabled = page >= pageCount;
+        pageLabel.textContent =
+          `第 ${num(page)} / ${num(pageCount)} 页 · 本页 ${num(rows.length)} 条 · 可浏览 ${num(list.length)} 条`;
+        frozenLabel.textContent = frozenRounds === null ? '' : '列表已冻结，不随刷新变化';
+        // 截断与「翻不到更早的」必须写在表下面：只看到表的人不能以为这就是全部轮次。
+        const noteParts: string[] = [];
+        noteParts.push(
+          state.roundsOmitted > 0
+            ? `⋯ 已加载最近 ${num(state.roundsShown)} 个轮次，另有更早的 ${num(state.roundsOmitted)} 个轮次未加载`
+              + '（未加载的翻不到，但它们仍计入上面的汇总）。'
+            : `⋯ 已加载全部 ${num(state.roundsShown)} 个轮次。`,
+        );
+        if (frozenRounds !== null) noteParts.push('列表已冻结，点「查看最新」回到最新。');
+        roundNote.textContent = noteParts.join(' ');
+      }
+
+      const last = state.scopes.find((scope) => scope.key === 'overall');
+      sourceTable.addRow(['数据目录', state.dataDirLabel]);
+      sourceTable.addRow(['时间范围', windowText(state)]);
+      sourceTable.addRow(['记录', `${num(state.source.dedupedRecords)} 条（重复 recordId ${num(state.source.duplicateRecordIds)}、无 recordId ${num(state.source.noRecordId)}；工具调用 ${num(state.source.toolCalls)} 条）`]);
+      sourceTable.addRow(['上次刷新新读', `用量 ${num(state.source.lastRead.usage)} 条、工具调用 ${num(state.source.lastRead.toolCalls)} 条、文件 ${num(state.source.lastRead.files)} 个${state.source.lastRead.rebuilds > 0 ? `；重建 ${num(state.source.lastRead.rebuilds)} 次` : ''}`]);
+      sourceTable.addRow(['最近更新', last?.lastUpdated ?? '—']);
+      sourceTable.addRow(['时区', state.timezone]);
+      sourceTable.addRow(['费用', state.cost.text]);
+      sourceTable.addRow(['文件状态', sourceStatus(state)]);
+      fillNotes(state);
+    };
+
+    /** 时间范围一句话。起点固定这件事必须说出来，否则会读成滚动窗口。 */
+    const windowText = (state: MinecraftUsageState): string => {
+      const skipped = state.window.skippedBeforeSince;
+      const fixed = state.window.rolling ? '随「现在」滑动' : '起点固定在首次读取那一刻，不随「现在」滑动';
+      return `最近 ${state.window.days} 天（自 ${state.window.sinceIso}；${fixed}）`
+        + (skipped > 0 ? `；更早的 ${num(skipped)} 条未计入` : '');
+    };
+
+    const fillNotes = (state: MinecraftUsageState): void => {
+      const lines = [
+        ...state.notes,
+        '缓存对账：命中 + 未缓存与输入一致时打 ✓；有未知读数时不声称对得上。',
+      ];
+      for (const line of lines) noteList.appendChild(ui.h('div', null, line));
+    };
+
+    const poll = (): void => {
+      if (polling) return;
+      polling = true;
+      void ctx.invoke<MinecraftUsageState>('state').then(
+        (state) => {
+          polling = false;
+          first = false;
+          render(state ?? null);
+        },
+        (err: unknown) => {
+          polling = false;
+          if (ctx.signal.aborted) return;
+          const bad = err instanceof Error ? err.message : String(err);
+          if (first) render(null);
+          msg.textContent = bad;
+          msg.classList.add('bad');
+        },
+      );
+    };
+    let polling = false;
+
+    scopeTable.clear('正在读取…');
+    msg.textContent = '正在读取…';
+    ctx.interval(poll, POLL_MS);
+    poll();
+  },
+};
+
+function sourceStatus(state: MinecraftUsageState): string {
+  const parts: string[] = [];
+  const a = state.anomalies;
+  if (a.missingUsage) parts.push('用量日志不在');
+  if (a.missingRunsDir) parts.push('运行日志目录不在');
+  if (a.badLines > 0) parts.push(`坏行 ${a.badLines} 条`);
+  if (a.truncations > 0) parts.push(`日志截断重读 ${a.truncations} 次`);
+  if (a.rebuilds > 0) parts.push(`撤销旧贡献重建 ${a.rebuilds} 次`);
+  if (a.unreadableRuns > 0) parts.push(`${a.unreadableRuns} 个运行目录读不了`);
+  if (a.missingRunLogs > 0) parts.push(`${a.missingRunLogs} 个运行目录没有工具调用日志`);
+  if (a.partialLines > 0) parts.push(`${a.partialLines} 行还没写完，等下一次刷新`);
+  if (parts.length === 0) return `正常（运行目录 ${num(a.runDirs)} 个）`;
+  return parts.join('；');
+}
