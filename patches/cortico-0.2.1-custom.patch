index 0000000..da6ad1a
--- /dev/null
+++ b/src/worlds/minecraft/usage/timeline-state.mjs
@@ -0,0 +1,132 @@
+/**
+ * 时间线面板只读适配层：把当前 run 的日志投影成控制台「动作时间线」面板要显示的 JSON。
+ *
+ * 只读部署传入的 dataDir 下 `<dataDir>/runs/<当前 run>/` 的两个固定文件
+ * （toolcalls.jsonl、log.jsonl），不接受调用方给的任意路径；游标留在进程里，
+ * 之后每次只读新增字节，不重扫整个 run。不写盘、不调模型、不发消息。
+ *
+ * 统计口径是完整当前 run；列表只保留最近 `maxEntries` 条。
+ */
+
+import { TimelineSource, buildTimeline, TIMELINE_MAX_ENTRIES, TIMELINE_PAGE_SIZE, TIMELINE_DETAIL_CHARS } from './timeline.mjs';
+import { TIMEZONE, epochOf } from './types.mjs';
+
+/** 两次刷新之间的最短间隔；面板轮询比它快时直接复用上一次结果。 */
+export const TIMELINE_REFRESH_TTL_MS = 5_000;
+
+/** dataDir → 已有游标的读取器。 */
+const sources = new Map();
+
+/** 丢掉缓存的读取器。测试在同一个目录上换参数时用它。 */
+export function resetTimelineCache() {
+  sources.clear();
+}
+
+function epochMs(value) {
+  if (value instanceof Date) return value.getTime();
+  if (typeof value === 'number' && Number.isFinite(value)) return value;
+  if (typeof value === 'string' && value !== '') return epochOf(value);
+  return null;
+}
+
+async function sourceFor(dataDir, opts) {
+  let entry = sources.get(dataDir);
+  if (entry === undefined) {
+    entry = { source: new TimelineSource(dataDir), refreshedAt: 0 };
+    sources.set(dataDir, entry);
+  }
+  if (entry.refreshing) {
+    await entry.refreshing;
+  } else if (Date.now() - entry.refreshedAt >= opts.refreshTtlMs) {
+    entry.refreshing = entry.source.refresh().then(() => { entry.refreshedAt = Date.now(); });
+    try { await entry.refreshing; } finally { entry.refreshing = null; }
+  }
+  return entry;
+}
+
+/** 目录在界面上怎么称呼：`mybot/data`，不印整条主机路径。 */
+function dirLabel(dataDir) {
+  const parts = dataDir.replaceAll('\\', '/').replace(/\/+$/, '').split('/').filter((p) => p !== '');
+  return parts.slice(-2).join('/') || dataDir;
+}
+
+/**
+ * 读一次并投影。
+ *
+ * @param {string} dataDir 部署数据目录；空串直接报错，不从别处猜路径
+ * @param {object} [options]
+ * @param {string|number|Date} [options.now] 注入「现在」，只影响 `generatedAt`
+ * @param {number} [options.refreshTtlMs] 刷新最短间隔；给 0 表示每次都刷新（仍只读新增字节）
+ * @param {number} [options.maxEntries] 时间线最多保留多少条
+ * @param {number} [options.pageSize] 每页条数
+ * @param {number} [options.detailChars] 单条 detail 最多多少字符
+ * @param {string} [options.timezone] 统计时区
+ */
+export async function timelineState(dataDir, options = {}) {
+  if (typeof dataDir !== 'string' || dataDir === '') {
+    throw new Error('没有部署数据目录，读不到动作时间线');
+  }
+  const opts = {
+    timezone: options.timezone ?? TIMEZONE,
+    nowMs: epochMs(options.now) ?? Date.now(),
+    refreshTtlMs: options.refreshTtlMs ?? TIMELINE_REFRESH_TTL_MS,
+    maxEntries: options.maxEntries ?? TIMELINE_MAX_ENTRIES,
+    pageSize: options.pageSize ?? TIMELINE_PAGE_SIZE,
+    detailChars: options.detailChars ?? TIMELINE_DETAIL_CHARS,
+  };
+
+  const entry = await sourceFor(dataDir, opts);
+  const result = buildTimeline(
+    { run: entry.source.run, toolCalls: entry.source.toolCalls, events: entry.source.events },
+    {
+      maxEntries: opts.maxEntries,
+      pageSize: opts.pageSize,
+      detailChars: opts.detailChars,
+    },
+  );
+
+  const anomalies = entry.source.anomalySummary;
+  const notes = [
+    '时间线覆盖当前 run 的全部记录；统计口径是完整当前 run，不是列表里那几百条。',
+    '列表按时间倒序，最多保留最近 '
+      + `${result.maxEntries} 条；超出部分在「未展示」里如实计数。`,
+    '工具调用与执行器事件分开列出：一次 mc_do / mc_queue 只表示模型下过这条令，'
+      + '队列里每一步做没做成功要看执行器事件。',
+    '有开始而没有配对到结束的步骤计为未结束，不推断成成功。',
+  ];
+  if (anomalies.missingLog) notes.push('当前 run 目录里没有 log.jsonl，只有工具调用那一半。');
+  if (anomalies.skippedEvents > 0) {
+    notes.push(`另有 ${anomalies.skippedEvents} 条日志不是执行器边界事件，未进时间线。`);
+  }
+
+  return {
+    hasData: result.total > 0,
+    noDataLine: '这个 run 还没有可看的动作记录。',
+    generatedAt: new Date(opts.nowMs).toISOString(),
+    timezone: opts.timezone,
+    dataDirLabel: dirLabel(dataDir),
+    run: result.run,
+    source: {
+      run: entry.source.run,
+      runDirs: sources.size,
+      missingRunsDir: anomalies.missingRunsDir,
+      missingToolCalls: anomalies.missingToolCalls,
+      missingLog: anomalies.missingLog,
+      skippedEvents: anomalies.skippedEvents,
+      badLines: anomalies.badLines,
+      truncations: anomalies.truncations,
+      /** 上一次刷新真正读了多少新行；用来核对「刷新不重扫整个 run」。 */
+      lastRead: { ...entry.source.lastRefreshRead },
+      refreshedAt: entry.refreshedAt,
+    },
+    anomalies,
+    notes,
+    entries: result.entries,
+    omitted: result.omitted,
+    total: result.total,
+    maxEntries: result.maxEntries,
+    pageSize: result.pageSize,
+    newestFirst: result.newestFirst,
+    stats: result.stats,
+  };
+}
