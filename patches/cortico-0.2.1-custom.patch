+/**
+ * 纯聚合器：把用量记录与工具调用记录折成面板要显示的数字。
+ *
+ * 口径（任务书「GPT已确定的统计口径」）：
+ * - 统计的是「Minecraft 相关轮次用量」，即整个轮次的请求消耗，不是 Minecraft 独占消耗。
+ * - 一条用量记录 = 一次请求 attempt；同一个轮次的不同 attempt 各计一次，不去重。
+ * - 同一个轮次里出现多个 mc_ 工具不会让它多算：轮次的请求次数由用量记录决定。
+ * - reasoning 通常已含在 output 里，只单列，不再加进 output。
+ * - 缓存属于输入：cached 与 uncached 必须能与 input 对上；对不上或未知时如实标出。
+ * - 绝不按字符长度、工具条数或事件条数去切分 token。
+ *
+ * 本模块不碰文件系统，读盘由 incremental.mjs 负责，格式化由 report.mjs 负责。
+ */
+
+import { classifyAll } from './classify.mjs';
+import {
+  CATEGORY,
+  CATEGORY_LABEL,
+  CATEGORY_ORDER,
+  TIMEZONE,
+  epochOf,
+  localDateKey,
+  readMeters,
+} from './types.mjs';
+
+/** 一次聚合的可选参数。 */
+export const DEFAULT_OPTIONS = {
+  timezone: TIMEZONE,
+  /** 报告时刻；测试可注入固定值。 */
+  now: undefined,
+  /** 最近 1 小时的窗口长度。 */
+  recentWindowMs: 3_600_000,
+  /** 单轮明细最多列多少条。 */
+  maxRoundDetails: 200,
+  /** 明细每页多少条。分页只作用于上面这批已加载的轮次，不去翻更早的历史。 */
+  roundPageSize: 25,
+};
+
+/**
+ * 「Minecraft 相关轮次」汇总的标题。
+ *
+ * 它统计的是整个轮次的请求消耗，不是 Minecraft 独占消耗——混合轮次里 QQ 等其他 World
+ * 的动作也在同一轮请求内，无法按 token 切分，所以整轮计入并如实标注口径。
+ */
+export const MC_SCOPE_LABEL = 'Minecraft 相关轮次（整轮计入，非独占）';
+
+/** 三类与 Minecraft 相关的轮次分类。 */
+function isMinecraftCategory(category) {
+  return (
+    category === CATEGORY.WORLD_SELF ||
+    category === CATEGORY.MIXED ||
+    category === CATEGORY.MC_ROUND
+  );
+}
+
+/**
+ * 聚合。
+ *
+ * @param {object[]} records 已解析的 UsageRecord 数组（可能是增量累积的全量）
+ * @param {object[]} toolCalls 已投影的 ToolCallEntry 数组
+ * @param {object} [options]
+ */
+export function aggregate(records, toolCalls, options = {}) {
+  const opts = { ...DEFAULT_OPTIONS, ...options };
+  const now = opts.now instanceof Date ? opts.now : new Date(opts.now ?? Date.now());
+  const nowMs = now.getTime();
+  const todayKey = localDateKey(now.toISOString(), opts.timezone);
+
+  // 去重：同一条记录只算一次。重复 recordId 不重复计入，但如实计数。
+  const seen = new Set();
+  const deduped = [];
+  let duplicateRecordIds = 0;
+  let noRecordId = 0;
+  for (const record of records) {
+    const id = typeof record.recordId === 'string' && record.recordId !== '' ? record.recordId : null;
+    if (id === null) {
+      // 没有 recordId 的记录无法去重，也不能丢；照常计入并标记。
+      noRecordId += 1;
+      deduped.push(record);
+      continue;
+    }
+    if (seen.has(id)) {
+      duplicateRecordIds += 1;
+      continue;
+    }
+    seen.add(id);
+    deduped.push(record);
+  }
+
+  const { classified, counts } = classifyAll(deduped, toolCalls);
+
+  const overall = emptyScope('全部');
+  const windows = {
+    today: emptyScope('今日'),
+    currentRun: emptyScope('当前 run'),
+    lastHour: emptyScope('最近 1 小时'),
+  };
+
+  const currentRunId = currentRunOf(deduped);
+  windows.currentRun.run = currentRunId;
+
+  /**
+   * Minecraft 相关轮次汇总：只含三类 MC 轮次，与上面「全部轮次」的全会话汇总并列。
+   *
+   * 顶部表要回答的是「游戏相关花了多少」，所以它必须用这一套，而不是全会话总量。
+   * 三类之外（其余主会话轮次、未能归类）一律不进这里，它们的量在 categories 与
+   * overall 里如实保留，只作对照。
+   */
+  const minecraft = {
+    label: MC_SCOPE_LABEL,
+    scopes: [
+      emptyScope('全部'),
+      emptyScope('今日'),
+      emptyScope('当前 run'),
+      emptyScope('最近 1 小时'),
+    ],
+  };
+  const [mcOverall, mcToday, mcCurrentRun, mcLastHour] = minecraft.scopes;
+
+  const roundDetails = new Map();
+
+  for (const item of classified) {
+    const { record, category, reason } = item;
+    const meters = readMeters(record);
+    const ts = typeof record.ts === 'string' ? record.ts : null;
+    const tsMs = ts === null ? null : epochOf(ts);
+    const dateKey = ts === null ? null : localDateKey(ts, opts.timezone);
+    const outcome = outcomeOf(record);
+
+    const entry = {
+      record,
+      category,
+      reason,
+      meters,
+      ts,
+      tsMs,
+      dateKey,
+      outcome,
+      unknown: isUnknownUsage(meters),
+      degraded: meters.degraded,
+    };
+
+    addToScope(overall, entry);
+    const inToday = dateKey !== null && dateKey === todayKey;
+    const inCurrentRun = currentRunId !== null && record.run === currentRunId;
+    const inLastHour = tsMs !== null && tsMs <= nowMs && tsMs > nowMs - opts.recentWindowMs;
+    if (inToday) addToScope(windows.today, entry);
+    if (inCurrentRun) addToScope(windows.currentRun, entry);
+    if (inLastHour) addToScope(windows.lastHour, entry);
+
+    // Minecraft 相关轮次汇总：只累加三类 MC 轮次，窗口划分与全会话口径一致。
+    if (isMinecraftCategory(category)) {
+      addToScope(mcOverall, entry);
+      if (inToday) addToScope(mcToday, entry);
+      if (inCurrentRun) addToScope(mcCurrentRun, entry);
+      if (inLastHour) addToScope(mcLastHour, entry);
+    }
+
+    // 单轮明细：只列与 Minecraft 相关的三类轮次，供面板下钻。
+    if (isMinecraftCategory(category)) {
+      const key = `${record.run}\u0000${record.round}\u0000${record.role}`;
+      let detail = roundDetails.get(key);
+      if (detail === undefined) {
+        detail = {
+          run: record.run ?? null,
+          round: record.round ?? null,
+          role: record.role ?? null,
+          category,
+          attempts: 0,
+          input: 0,
+          cached: 0,
+          uncached: 0,
+          output: 0,
+          reasoning: 0,
+          unknownCache: 0,
+          /** 有记录把 cached/uncached 读成 null 时，该列显示为未知而不是 0。 */
+          cachedUnknown: 0,
+          uncachedUnknown: 0,
+          failed: 0,
+          models: new Set(),
+          firstTs: ts,
+          lastTs: ts,
+        };
+        roundDetails.set(key, detail);
+      }
+      detail.attempts += 1;
+      detail.input += meters.input ?? 0;
+      detail.cached += meters.cached ?? 0;
+      detail.uncached += meters.uncached ?? 0;
+      detail.output += meters.output ?? 0;
+      detail.reasoning += meters.reasoning ?? 0;
+      if (meters.cached === null) detail.cachedUnknown += 1;
+      if (meters.uncached === null) detail.uncachedUnknown += 1;
+      if (meters.cacheState === 'unknown') detail.unknownCache += 1;
+      if (outcome === 'failed' || outcome === 'discarded') detail.failed += 1;
+      if (typeof record.model === 'string') detail.models.add(record.model);
+      if (ts !== null && (detail.firstTs === null || ts < detail.firstTs)) detail.firstTs = ts;
+      if (ts !== null && (detail.lastTs === null || ts > detail.lastTs)) detail.lastTs = ts;
+    }
+  }
+
+  finalizeScope(overall);
+  for (const scope of Object.values(windows)) finalizeScope(scope);
+  for (const scope of minecraft.scopes) finalizeScope(scope);
+  // 与全会话口径用同一个当前 run，便于对照阅读。
+  mcCurrentRun.run = currentRunId;
+
+  // 明细超过上限时，优先保留**最近**的轮次：按时间倒序挑出要展示的那一批。
+  // 输出也保持倒序（最新在顶部），分页时每一页的顺序与整体一致，不会翻页就换一种排法。
+  // 被丢掉的条数如实回报，面板据此标明截断，不能让读者以为这就是全部。
+  const byRecency = [...roundDetails.values()].sort(compareRoundRecency);
+  const kept = byRecency.slice(0, opts.maxRoundDetails);
+  const roundsOmitted = byRecency.length - kept.length;
+
+  const roundList = kept.map((detail) => ({
+      run: detail.run,
+      round: detail.round,
+      role: detail.role,
+      category: detail.category,
+      attempts: detail.attempts,
+      input: detail.input,
+      output: detail.output,
+      reasoning: detail.reasoning,
+      unknownCache: detail.unknownCache,
+      failed: detail.failed,
+      models: [...detail.models],
+      firstTs: detail.firstTs,
+      lastTs: detail.lastTs,
+      cacheReconciled: detail.cached + detail.uncached === detail.input && detail.unknownCache === 0,
+      /** 该轮次只要有记录读不到缓存，缓存列就显示未知，不显示 0。 */
+      cached: detail.cachedUnknown > 0 ? null : detail.cached,
+      uncached: detail.uncachedUnknown > 0 ? null : detail.uncached,
+    }));
+
+  const totalClassified = CATEGORY_ORDER.reduce((sum, category) => sum + counts[category], 0);
+
+  return {
+    hasData: deduped.length > 0,
+    generatedAt: now.toISOString(),
+    timezone: opts.timezone,
+    source: {
+      records: records.length,
+      dedupedRecords: deduped.length,
+      duplicateRecordIds,
+      noRecordId,
+      toolCalls: toolCalls.length,
+    },
+    /** 分类计数，五类互斥，合计必须等于去重后的记录数。 */
+    categories: CATEGORY_ORDER.map((category) => ({
+      category,
+      label: CATEGORY_LABEL[category],
+      count: counts[category],
+      share: totalClassified === 0 ? null : counts[category] / totalClassified,
+    })),
+    /** 互斥性自检：五类合计与总记录数一致。 */
+    reconciliation: {
+      classifiedTotal: totalClassified,
+      inputTotal: deduped.length,
+      balanced: totalClassified === deduped.length,
+    },
+    /** 未能归类的细分原因，单列不丢弃。 */
+    unclassifiedReasons: unclassifiedReasons(classified),
+    /**
+     * 顶部表用的 Minecraft 相关轮次汇总（只含三类 MC 轮次）。
+     * `scopes` 顺序固定为 [全部, 今日, 当前 run, 最近 1 小时]。
+     */
+    minecraft: { label: minecraft.label, scopes: minecraft.scopes },
+    /** 全会话汇总，保留作对照。它含所有分类，不能当作 Minecraft 用量。 */
+    overall,
+    windows,
+    rounds: roundList,
+    /** 因超出 maxRoundDetails 而未展示的轮次数（丢掉的都是更早的）。 */
+    roundsOmitted,
+    roundsShown: roundList.length,
+    /** 明细顺序：最新的在最前。分页只在 roundsShown 条里翻，翻不到更早的历史。 */
+    roundsNewestFirst: true,
+    roundPageSize: opts.roundPageSize,
+    cost: summarizeCost(classified),
+    notes: buildNotes(deduped, classified),
+  };
+}
+
+/**
+ * 轮次新旧比较：新在前。
+ *
+ * 用 lastTs 判定；缺时间戳的轮次排在有时间戳的后面（读不出时间就不冒充“最近”）。
+ * 同一时刻再按 run / round 倒序，保证顺序稳定可复现。
+ */
+function compareRoundRecency(a, b) {
+  if (a.lastTs !== b.lastTs) {
+    if (a.lastTs === null) return 1;
+    if (b.lastTs === null) return -1;
+    return a.lastTs < b.lastTs ? 1 : -1;
+  }
+  return compareRoundChronological(b, a);
+}
+
+/** 轮次展示顺序：按 run、round 升序，从旧到新。 */
+function compareRoundChronological(a, b) {
+  if (a.run === b.run) return (a.round ?? 0) - (b.round ?? 0);
+  return String(a.run).localeCompare(String(b.run));
+}
+
+/**
+ * 费用汇总。
+ *
+ * 只统计 Minecraft 相关轮次（自有调用、混合、含 Minecraft 操作）里记录本身带出的金额与币种：
+ * attempt.charges[].quote.currency + amount。没有计价信息的记录不按 0 计，单列为「计价未知」。
+ * 免费线路与缓存命中都不等于零成本。
+ */
+function summarizeCost(classified) {
+  const byCurrency = new Map();
+  let knownCount = 0;
+  let unknownCount = 0;
+  for (const item of classified) {
+    if (
+      item.category !== CATEGORY.WORLD_SELF &&
+      item.category !== CATEGORY.MIXED &&
+      item.category !== CATEGORY.MC_ROUND
+    ) {
+      continue;
+    }
+    const charges = item.record.attempt?.charges;
+    if (!Array.isArray(charges) || charges.length === 0) {
+      unknownCount += 1;
+      continue;
+    }
+    let counted = false;
+    for (const charge of charges) {
+      const amount = typeof charge?.amount === 'number' && Number.isFinite(charge.amount) ? charge.amount : null;
+      const currency = charge?.quote?.currency;
+      if (amount === null || typeof currency !== 'string' || currency === '') continue;
+      byCurrency.set(currency, (byCurrency.get(currency) ?? 0) + amount);
+      counted = true;
+    }
+    if (counted) knownCount += 1;
+    else unknownCount += 1;
+  }
+  return {
+    entries: [...byCurrency.entries()].map(([currency, amount]) => ({
+      currency,
+      amount: Math.round(amount * 1e8) / 1e8,
+    })),
+    knownCount,
+    unknownCount,
+  };
+}
+
+function emptyScope(label) {
+  return {
+    label,
+    run: null,
+    attempts: 0,
+    rounds: 0,
+    input: 0,
+    output: 0,
+    cached: 0,
+    uncached: 0,
+    reasoning: 0,
+    unknownUsage: 0,
+    unknownCache: 0,
+    degraded: 0,
+    failed: 0,
+    discarded: 0,
+    cacheMismatch: 0,
+    categories: Object.fromEntries(CATEGORY_ORDER.map((category) => [category, 0])),
+    models: new Set(),
+    lastUpdated: null,
+    roundKeys: new Set(),
+  };
+}
+
+function addToScope(scope, entry) {
+  const { record, category, meters, outcome } = entry;
+  scope.attempts += 1;
+  scope.roundKeys.add(`${record.run}\u0000${record.round}\u0000${record.role}`);
+  // 未知的仪表读数不进总量：把未知当零会得出误导性的“用量 0”。
+  if (meters.input !== null) scope.input += meters.input;
+  if (meters.output !== null) scope.output += meters.output;
+  if (meters.cached !== null) scope.cached += meters.cached;
+  if (meters.uncached !== null) scope.uncached += meters.uncached;
+  if (meters.reasoning !== null) scope.reasoning += meters.reasoning;
+  if (entry.unknown) scope.unknownUsage += 1;
+  if (meters.cacheState === 'unknown') scope.unknownCache += 1;
+  if (meters.cacheState === 'mismatch') scope.cacheMismatch += 1;
+  if (entry.degraded) scope.degraded += 1;
+  if (outcome === 'failed') scope.failed += 1;
+  if (outcome === 'discarded') scope.discarded += 1;
+  scope.categories[category] += 1;
+  if (typeof record.model === 'string') scope.models.add(record.model);
+  if (entry.ts !== null && (scope.lastUpdated === null || entry.ts > scope.lastUpdated)) {
+    scope.lastUpdated = entry.ts;
+  }
+}
+
+function finalizeScope(scope) {
+  scope.rounds = scope.roundKeys.size;
+  scope.models = [...scope.models];
+  delete scope.roundKeys;
+  // 缓存对账：cached + uncached 是否等于 input。有未知缓存时不声称对得上。
+  scope.cacheReconciles = scope.unknownCache === 0 && scope.cached + scope.uncached === scope.input;
+}
+
+/** 轮次归属的 outcome：顶层缺失时回落到 attempt.outcome。 */
+function outcomeOf(record) {
+  if (typeof record.outcome === 'string') return record.outcome;
+  const attempt = record.attempt;
+  if (attempt && typeof attempt.outcome === 'string') return attempt.outcome;
+  return null;
+}
+
+/** 是否有仪表读数未知。 */
+function isUnknownUsage(meters) {
+  return meters.input === null || meters.output === null || meters.cacheState === 'unknown';
+}
+
+/** 未能归类的细分原因计数。 */
+function unclassifiedReasons(classified) {
+  const reasons = new Map();
+  for (const item of classified) {
+    if (item.category !== CATEGORY.UNCLASSIFIED) continue;
+    const reason = item.reason ?? 'unspecified';
+    reasons.set(reason, (reasons.get(reason) ?? 0) + 1);
+  }
+  return [...reasons.entries()].map(([reason, count]) => ({ reason, count }));
+}
+
+/** 当前 run：取最新一条带 ts 的记录所在的 run。 */
+function currentRunOf(records) {
+  let bestRun = null;
+  let bestTs = null;
+  for (const record of records) {
+    if (typeof record.run !== 'string' || typeof record.ts !== 'string') continue;
+    if (bestTs === null || record.ts > bestTs) {
+      bestTs = record.ts;
+      bestRun = record.run;
+    }
+  }
+  return bestRun;
+}
+
+/** 报告顶部的口径提示与异常说明。 */
+function buildNotes(records, classified) {
+  const notes = [];
+  let degraded = 0;
+  let unknownCache = 0;
+  let mismatch = 0;
+  for (const item of classified) {
+    const meters = readMeters(item.record);
+    if (meters.degraded) degraded += 1;
+    if (meters.cacheState === 'unknown') unknownCache += 1;
+    if (meters.cacheState === 'mismatch') mismatch += 1;
+  }
+
+  notes.push('统计口径为整个轮次的请求消耗，不是 Minecraft 独占消耗。');
+  notes.push(
+    `顶部「${MC_SCOPE_LABEL}」只累计 Minecraft 自有调用、混合操作轮次、含 Minecraft 操作的轮次三类；` +
+      '其余主会话轮次与未能归类不进这套数字，只在下方「全部轮次」对照里出现。',
+  );
+  notes.push('分类数量不能替代 token 汇总：五类计数说明轮次归属，金额与 token 一律以汇总表为准。');
+  if (degraded > 0) {
+    notes.push(`${degraded} 条旧格式记录没有 attempt.meters，只能用兼容数值字段；其缓存读数可能把未知写成 0，缓存一律按未知处理。`);
+  }
+  if (unknownCache > 0) {
+    notes.push(`${unknownCache} 条记录的缓存读数未知（null），显示为未知而不是 0。`);
+  }
+  if (mismatch > 0) {
+    notes.push(`${mismatch} 条记录的 cached+uncached 与 input 对不上，已单独标记。`);
+  }
+  notes.push('含 Minecraft 思考但没有 mc_ 工具调用的轮次无法识别，会落在「其余主会话轮次」，这是已知的少算边界。');
+  return notes;
+}
+
+export { CATEGORY, CATEGORY_LABEL, CATEGORY_ORDER };
