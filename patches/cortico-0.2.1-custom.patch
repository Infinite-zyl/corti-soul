+import { records } from '../core/fixture-protocol.ts';
+const dirs: string[] = [];
+const policy = { maxTokens: 64000, softRatio: 0.85, keepRatio: 1 / 3 };
+function setup() {
+  const dir = mkdtempSync(join(tmpdir(), 'context-console-')); dirs.push(dir);
+  return { dir, panel: new ContextConsole(dir) };
+}
+afterEach(() => { for (const dir of dirs.splice(0)) rmSync(dir, { recursive: true, force: true }); });
+describe('context observations', () => {
+  it('reports unavailable capacity honestly before attachment and reads old notes without inventing metrics', () => {
+    const { dir, panel } = setup();
+    expect(panel.state(null, policy, false)).toMatchObject({ attached: false, currentTokens: null, handoffs: [] });
+    mkdirSync(join(dir, 'handoffs'));
+    writeFileSync(join(dir, 'handoffs/2026-10-15T12-30-00Z.md'), '<script>plain note</script>');
+    const st = panel.state(null, policy, false);
+    expect(st.handoffs[0]).toMatchObject({ at: '2026-10-15T12:30:00Z', metric: null });
+    expect(panel.read(st.handoffs[0].file).content).toBe('<script>plain note</script>');
+    expect(() => panel.read('handoffs/../../.env')).toThrow();
+    expect(() => panel.read('handoffs/.context-metrics.json')).toThrow();
+  });
+  it('keeps reported capacity distinct from local classification and restores recorded handoff facts', () => {
+    const { dir, panel } = setup(); mkdirSync(join(dir, 'handoffs'));
+    const file = 'handoffs/2026-10-16T03-00-00Z.md'; writeFileSync(join(dir, file), 'saved note');
+    const snapshot = records([{ role: 'system', content: 'instructions' }, { role: 'user', content: 'a question' }]);
+    const info = { id: 'main', running: 1, estTokens: 54321, hardTokens: 120000, snapshot };
+    panel.record(handoffMetric(file, snapshot, { text: 'saved note', entries: 4, dropped: 2 }, info));
+    const st = new ContextConsole(dir).state(info, policy, true);
+    expect(st.currentTokens).toBe(info.estTokens);
+    expect(st.categories.map(row => row.name)).toEqual(['system', 'dialogue']);
+    expect(st.categories.reduce((sum, row) => sum + row.tokens, 0)).not.toBe(info.estTokens);
+    expect(st.handoffs[0].metric).toMatchObject({ beforeTokens: info.estTokens, entries: 4, dropped: 2 });
+  });
+  it('rejects linked handoff directories and oversized note previews', () => {
+    const { dir, panel } = setup(); const other = setup().dir;
+    symlinkSync(other, join(dir, 'handoffs'), process.platform === 'win32' ? 'junction' : 'dir');
+    expect(() => panel.state(null, policy, false)).toThrow();
+    rmSync(join(dir, 'handoffs'));
+    mkdirSync(join(dir, 'handoffs'));
+    const file = 'handoffs/2026-10-16T03-00-00Z.md'; writeFileSync(join(dir, file), 'x'.repeat(300000));
+    expect(() => panel.read(file)).toThrow('256 KiB');
+  });
+  it('observes a real Persona handoff and never lets metric failure prevent note delivery', async () => {
+    const { dir } = setup();
+    const snapshot = records([{ role: 'user', content: 'remember this pending task' }]);
+    const info = { id: 'main', running: 1, estTokens: 55000, hardTokens: 120000, snapshot };
+    const persona = new Cormini({ memoryDir: dir, context: () => ({ ...policy, firstTurn: false }) });
+    const delivered: string[] = [];
+    persona.attach({ sessionInfo: () => info, toolsTagged: () => new Set(),
+      injectInternal: () => {}, injectExternal: (text: string) => delivered.push(text), log: { warn: () => {} } } as never);
+    await persona.onHandoff(snapshot, { hardTokens: info.hardTokens });
+    const invoke = persona.webUi().invoke!;
+    const state = await invoke('context', 'state', []) as ReturnType<ContextConsole['state']>;
+    expect(state.handoffs[0].metric?.beforeTokens).toBe(info.estTokens);
+    expect(delivered.join('\n')).toContain('remember this pending task');
+    writeFileSync(join(dir, 'handoffs/.context-metrics.json'), 'broken observer data');
+    const damaged = await invoke('context', 'state', []) as ReturnType<ContextConsole['state']>;
+    expect(damaged.observationWarning).toContain('当前容量和交接笔记仍可查看');
+    expect(damaged.currentTokens).toBe(info.estTokens);
+    expect(damaged.handoffs[0].metric).toBeNull();
+    delivered.length = 0;
+    await expect(persona.onHandoff(snapshot, { hardTokens: info.hardTokens })).resolves.toEqual({ tail: [] });
+    expect(delivered.join('\n')).toContain('remember this pending task');
+  });
+});
