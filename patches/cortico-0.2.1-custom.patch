@@ -0,0 +1,114 @@
+/**
+ * 轮次归属判定。
+ *
+ * 输入是同一批用量记录与工具调用记录，输出每条用量记录的归属。判定只看元数据，
+ * 不读轮次正文，因此“有 Minecraft 思考但没有 mc_ 调用”的轮次必然落在规则 4，
+ * 这是第一版就声明在案的少算边界（见 README）。
+ */
+
+import {
+  CATEGORY,
+  REASON,
+  correlationKey,
+  isMinecraftTool,
+  looksLikeUsageRecord,
+  otherWorldOf,
+  worldSelfIdOf,
+} from './types.mjs';
+
+/**
+ * 把工具调用按 (run, round, role) 归拢，得出每个轮次的 Minecraft/其他 World 事实。
+ *
+ * 一个轮次里出现多个 mc_ 工具只记一次布尔事实；轮次的请求次数由用量记录决定，不由工具条数决定。
+ * runRounds 收集 (run, round)，用来区分“这个轮次没有记录”与“轮次存在但 role 对不上”。
+ */
+export function buildRoundIndex(toolCalls) {
+  const rounds = new Map();
+  const runRounds = new Set();
+  for (const entry of toolCalls) {
+    if (entry.run === undefined || entry.round === undefined || entry.role === undefined) continue;
+    runRounds.add(`${entry.run}\u0000${entry.round}`);
+    const key = correlationKey(entry.run, entry.round, entry.role);
+    let round = rounds.get(key);
+    if (round === undefined) {
+      round = {
+        run: entry.run,
+        round: entry.round,
+        role: entry.role,
+        minecraftTools: 0,
+        otherWorlds: new Set(),
+        degradedMod: false,
+      };
+      rounds.set(key, round);
+    }
+    if (isMinecraftTool(entry)) {
+      round.minecraftTools += 1;
+      // 旧日志缺 mod 时靠 mc_ 前缀识别，标记为降级识别，报告里如实交代覆盖范围。
+      if (entry.mod === undefined || entry.mod === null || entry.mod === '') round.degradedMod = true;
+    }
+    const other = otherWorldOf(entry);
+    if (other !== null) round.otherWorlds.add(other);
+  }
+  return { rounds, runRounds };
+}
+
+/**
+ * 判定一条用量记录的归属。
+ *
+ * 返回 { category, reason }，reason 只在未能归类时给出。
+ * 判定顺序即任务书的五条规则，前一条命中就不再往下走。
+ */
+export function classifyRecord(record, roundIndex) {
+  const { rounds, runRounds } = roundIndex;
+
+  // 规则 5 的一半：JSON 能解析但不具备任何用量字段的对象，形态无法识别，单列不猜测。
+  if (!looksLikeUsageRecord(record)) {
+    return { category: CATEGORY.UNCLASSIFIED, reason: REASON.UNKNOWN_FORMAT };
+  }
+
+  const worldSelfId = worldSelfIdOf(record);
+  if (worldSelfId !== null) {
+    // 规则 1：World 自报用量。只有 Minecraft 的 World 自报算 Minecraft；
+    // 其他 World 的自报（例如看画面的 worlds.gaming）单列为未能归类，不猜测成 Minecraft。
+    if (worldSelfId === 'worlds.minecraft') return { category: CATEGORY.WORLD_SELF, reason: null };
+    return { category: CATEGORY.UNCLASSIFIED, reason: REASON.WORLD_SELF_OTHER };
+  }
+
+  if (record.run === undefined || record.round === undefined || record.role === undefined) {
+    return { category: CATEGORY.UNCLASSIFIED, reason: REASON.NO_ROUND };
+  }
+
+  const key = correlationKey(record.run, record.round, record.role);
+  const round = rounds.get(key);
+  if (round === undefined) {
+    // 轮次根本没在 toolcalls 里出现过，还是出现过但 role 对不上，是两种不同的缺口。
+    const reason = runRounds.has(`${record.run}\u0000${record.round}`)
+      ? REASON.ROLE_MISMATCH
+      : REASON.NO_CORRELATION;
+    return { category: CATEGORY.UNCLASSIFIED, reason };
+  }
+
+  if (round.minecraftTools > 0) {
+    // 规则 2/3：同轮次里 Minecraft 与其他 World 并存算混合；只有 Minecraft 算含 Minecraft 操作。
+    // 含 Minecraft 操作不等于游戏独占，同轮的 QQ 上下文不改变这个判定。
+    if (round.otherWorlds.size > 0) return { category: CATEGORY.MIXED, reason: null };
+    return { category: CATEGORY.MC_ROUND, reason: null };
+  }
+
+  // 规则 4：可关联、无 Minecraft 工具。这里不叫“纯 QQ”：可能含游戏思考、只读状态或 end_turn。
+  return { category: CATEGORY.OTHER_MAIN, reason: null };
+}
+
+/** 批量判定，返回 { classified, counts }。 */
+export function classifyAll(records, toolCalls) {
+  const roundIndex = buildRoundIndex(toolCalls);
+  const classified = [];
+  const counts = Object.create(null);
+  for (const category of Object.values(CATEGORY)) counts[category] = 0;
+  for (const record of records) {
+    const { category, reason } = classifyRecord(record, roundIndex);
+    counts[category] += 1;
+    classified.push({ record, category, reason });
+  }
+  return { classified, counts, roundIndex };
+}
diff --git a/src/worlds/minecraft/usage/incremental.mjs b/src/worlds/minecraft/usage/incremental.mjs
new file mode 100644
index 0000000..46b88a3
--- /dev/null
+++ b/src/worlds/minecraft/usage/incremental.mjs
@@ -0,0 +1,174 @@
+/**
+ * JSONL 增量读取。
+ *
+ * 每个文件记住已消费的字节偏移与未完成的行尾巴。刷新时只读新增字节，不重扫历史。
+ * 三种情况都有确定行为：文件被截断（偏移归零重读）、最后一行还没写完（留在缓冲等下次）、
+ * 完整但坏掉的行（记一条异常并跳过，不猜内容）。
+ *
+ * 注意：截断与替换会从头重读，`lastReadReset` 因此置真。重读会把先前读过的行再交一遍，
+ * 调用方必须据此撤销该文件的旧贡献，否则旧记录会变成幽灵、截断掉的内容也不会消失。
+ */
+
+import { createReadStream } from 'node:fs';
+import { stat } from 'node:fs/promises';
+
+/** 一次增量读取的结果。 */
+export class JsonlFileState {
+  constructor(path, options = {}) {
+    this.path = path;
+    /** 已消费到的字节偏移。 */
+    this.offset = 0;
+    /** 上次读取后残留的未完成行（没有换行符结尾）。 */
+    this.tail = '';
+    /** 文件身份，用来发现文件被替换。 */
+    this.identity = null;
+    /** 上一次看到的文件大小，用来发现截断。 */
+    this.lastSize = 0;
+    /** 累积的异常计数。 */
+    this.anomalies = {
+      /** 完整但 JSON 解析失败的行。 */
+      badLines: 0,
+      /** 文件被截断（比上次短）后重读的次数。 */
+      truncations: 0,
+      /** 文件不存在。 */
+      missing: false,
+      /** 读取失败。 */
+      unreadable: false,
+    };
+    this.maxBadLineSamples = options.maxBadLineSamples ?? 5;
+    this.badLineSamples = [];
+    /** 每次读取新增的条目数，便于测试与报告。 */
+    this.lastReadCount = 0;
+    /**
+     * 本次读取是否因文件被截断或替换而从头重读。
+     *
+     * 调用方必须据此**撤销这个文件先前贡献的记录**：重读会把同一批行再交一次，
+     * 只追加不撤销就会把旧记录留成幽灵，且截断后本该消失的记录还在参与聚合。
+     */
+    this.lastReadReset = false;
+  }
+
+  /**
+   * 读一次增量。
+   *
+   * 返回本次新增的记录数组。文件不存在时返回空数组并置 missing，不抛错——
+   * 没有日志是正常状态（还没开过游戏），不是崩溃。
+   */
+  async read(options = {}) {
+    this.lastReadReset = false;
+    let info;
+    try {
+      info = await stat(this.path);
+    } catch (error) {
+      if (error.code === 'ENOENT') {
+        this.anomalies.missing = true;
+        this.lastReadCount = 0;
+        return [];
+      }
+      this.anomalies.unreadable = true;
+      this.lastReadCount = 0;
+      return [];
+    }
+
+    if (!info.isFile()) {
+      this.anomalies.unreadable = true;
+      this.lastReadCount = 0;
+      return [];
+    }
+
+    this.anomalies.missing = false;
+    const identity = `${info.dev ?? 0}:${info.ino ?? 0}`;
+    // 截断或文件被换掉：偏移作废，从头重读。
+    if (info.size < this.offset || (this.identity !== null && identity !== this.identity)) {
+      if (info.size < this.offset) this.anomalies.truncations += 1;
+      this.offset = 0;
+      this.tail = '';
+      // 告诉调用方这次是全量重读，先前的贡献要撤销。
+      this.lastReadReset = true;
+    }
+    this.identity = identity;
+    this.lastSize = info.size;
+
+    if (info.size === this.offset) {
+      this.lastReadCount = 0;
+      return [];
+    }
+
+    const chunk = await readRange(this.path, this.offset, info.size);
+    // 末尾若是半个多字节字符（写入方正好写到这里），这些字节不算消费：
+    // 留着下次连同后续字节一起读，否则会被解成替换字符，让完整行误报成坏行。
+    const dangling = trailingIncompleteBytes(chunk);
+    this.offset = info.size - dangling;
+
+    const text = this.tail + (dangling === 0 ? chunk : chunk.subarray(0, chunk.length - dangling)).toString('utf8');
+    const lines = text.split('\n');
+    // 最后一段没有换行符结尾，说明这行可能还没写完，留到下次。
+    this.tail = lines.pop() ?? '';
+
+    const records = [];
+    for (const line of lines) {
+      const trimmed = line.trim();
+      if (trimmed === '') continue; // 空行是正常的，不是异常。
+      let parsed;
+      try {
+        parsed = JSON.parse(trimmed);
+      } catch {
+        this.anomalies.badLines += 1;
+        if (this.badLineSamples.length < this.maxBadLineSamples) {
+          // 只留行号与长度，不留内容：日志行可能含正文。
+          this.badLineSamples.push({ bytes: Buffer.byteLength(trimmed) });
+        }
+        continue;
+      }
+      records.push(parsed);
+    }
+
+    this.lastReadCount = records.length;
+    return records;
+  }
+
+  /** 是否有未消费的尾巴（最后一行还没写完）。 */
+  get hasPartialLine() {
+    return this.tail.length > 0;
+  }
+
+  /** 强制下次从头读，用于部署切换。 */
+  reset() {
+    this.offset = 0;
+    this.tail = '';
+    this.identity = null;
+    this.lastSize = 0;
+  }
+}
+
+/** 读取 [start, end) 字节。返回 Buffer，由调用方决定怎么解码。 */
+function readRange(path, start, end) {
+  return new Promise((resolve, reject) => {
+    const chunks = [];
+    const stream = createReadStream(path, { start, end: end - 1 });
+    stream.on('data', (chunk) => chunks.push(chunk));
+    stream.on('end', () => resolve(Buffer.concat(chunks)));
+    stream.on('error', reject);
+  });
+}
+
+/**
+ * 末尾没有写完的多字节 UTF-8 字符占了几个字节。
+ *
+ * 从后往前找起始字节（不是 10xxxxxx 的那个），算出它应该有多长；不够长就说明没写完。
+ */
+function trailingIncompleteBytes(buffer) {
+  const maxSequence = 4;
+  const limit = Math.min(buffer.length, maxSequence);
+  for (let back = 1; back <= limit; back += 1) {
+    const byte = buffer[buffer.length - back];
+    if (byte < 0x80) return 0; // ASCII 结尾，完整。
+    if (byte >= 0xc0) {
+      // 起始字节：算出期望长度，与已有的后续字节数比较。
+      const expected = byte >= 0xf0 ? 4 : byte >= 0xe0 ? 3 : 2;
+      return back < expected ? back : 0;
+    }
+    // 10xxxxxx 是续字节，继续往前找。
+  }
+  return 0;
+}
diff --git a/src/worlds/minecraft/usage/panel-state.mjs b/src/worlds/minecraft/usage/panel-state.mjs
new file mode 100644
index 0000000..e74b870
--- /dev/null
+++ b/src/worlds/minecraft/usage/panel-state.mjs
@@ -0,0 +1,247 @@
+/**
+ * 面板只读适配层：把聚合结果投影成控制台「Minecraft 相关轮次用量」面板要显示的 JSON。
+ *
+ * 只读部署传入的 dataDir 下两个固定文件（usage.jsonl、runs/<run>/toolcalls.jsonl），
+ * 不接受调用方给的任意路径；首次读取按时间窗口收缩，之后每次只读新增字节并缓存结果。
+ * 不写盘、不调模型、不发消息；工具参数与回执在读取阶段就被丢掉，不进返回值。
+ *
+ * 磁盘上的字段名与内存里的形状都到这里为止：面板只认这里投影出来的字段。
+ */
+
+import { UsageSource } from './source.mjs';
+import { aggregate, MC_SCOPE_LABEL } from './aggregate.mjs';
+import { CATEGORY_LABEL, CATEGORY_ORDER, TIMEZONE, epochOf } from './types.mjs';
+import { NO_DATA_LINE, REASON_TEXT, SESSION_SCOPE_LABEL, formatCost } from './report.mjs';
+
+/** 首次读取覆盖多久。比「今日」长，跨零点的 run 仍能被完整计入。 */
+export const PANEL_WINDOW_DAYS = 3;
+/** 两次刷新之间的最短间隔；面板轮询比它快时直接复用上一次结果。 */
+export const PANEL_REFRESH_TTL_MS = 5_000;
+/** 单轮明细最多列多少条，与聚合器的默认上限一致。 */
+export const PANEL_MAX_ROUNDS = 200;
+/** 明细每页条数。只在这 200 条里翻页，翻不到更早的历史。 */
+export const PANEL_ROUND_PAGE_SIZE = 25;
+
+/** dataDir + 参数 → 已有游标的读取器。 */
+const sources = new Map();
+
+/** 丢掉缓存的读取器。测试在同一个目录上换参数时用它。 */
+export function resetUsageCache() {
+  sources.clear();
+}
+
+function epochMs(value) {
+  if (value instanceof Date) return value.getTime();
+  if (typeof value === 'number' && Number.isFinite(value)) return value;
+  if (typeof value === 'string' && value !== '') return epochOf(value);
+  return null;
+}
+
+async function sourceFor(dataDir, opts) {
+  const key = `${dataDir}\u0000${opts.sinceDays}\u0000${opts.refreshTtlMs}`;
+  let entry = sources.get(key);
+  if (entry === undefined) {
+    const sinceIso = new Date(opts.nowMs - opts.sinceDays * 86_400_000).toISOString();
+    entry = { source: new UsageSource(dataDir, { since: sinceIso }), sinceIso, refreshedAt: 0 };
+    sources.set(key, entry);
+  }
+  if (entry.refreshing) {
+    await entry.refreshing;
+  } else if (Date.now() - entry.refreshedAt >= opts.refreshTtlMs) {
+    entry.refreshing = entry.source.refresh().then(() => { entry.refreshedAt = Date.now(); });
+    try { await entry.refreshing; } finally { entry.refreshing = null; }
+  }
+  return entry;
+}
+
+/** 目录在界面上怎么称呼：`mybot/data`，不印整条主机路径。 */
+function dirLabel(dataDir) {
+  const parts = dataDir.replaceAll('\\', '/').replace(/\/+$/, '').split('/').filter((p) => p !== '');
+  return parts.slice(-2).join('/') || dataDir;
+}
+
+/**
+ * 读一次并投影。
+ *
+ * @param {string} dataDir 部署数据目录；空串直接报错，不从别处猜路径
+ * @param {object} [options]
+ * @param {string|number|Date} [options.now] 注入「现在」，测试用来固定三个时间窗口
+ * @param {number} [options.sinceDays] 首次读取覆盖的天数
+ * @param {number} [options.refreshTtlMs] 刷新最短间隔；给 0 表示每次都刷新（仍只读新增字节）
+ * @param {number} [options.maxRoundDetails] 单轮明细条数上限
+ * @param {number} [options.roundPageSize] 明细每页条数
+ * @param {string} [options.timezone] 统计时区
+ */
+export async function panelState(dataDir, options = {}) {
+  if (typeof dataDir !== 'string' || dataDir === '') {
+    throw new Error('没有部署数据目录，读不到用量记录');
+  }
+  const opts = {
+    timezone: options.timezone ?? TIMEZONE,
+    nowMs: epochMs(options.now) ?? Date.now(),
+    sinceDays: options.sinceDays ?? PANEL_WINDOW_DAYS,
+    refreshTtlMs: options.refreshTtlMs ?? PANEL_REFRESH_TTL_MS,
+    maxRoundDetails: options.maxRoundDetails ?? PANEL_MAX_ROUNDS,
+    roundPageSize: options.roundPageSize ?? PANEL_ROUND_PAGE_SIZE,
+  };
+
+  const entry = await sourceFor(dataDir, opts);
+  const result = aggregate(entry.source.records, entry.source.toolCalls, {
+    timezone: opts.timezone,
+    now: new Date(opts.nowMs),
+    maxRoundDetails: opts.maxRoundDetails,
+    roundPageSize: opts.roundPageSize,
+  });
+
+  const anomalies = { ...entry.source.anomalySummary };
+  const skipped = anomalies.skippedBeforeSince;
+  const notes = [...result.notes];
+  // 时间范围是**首次读取起点**，不是随「现在」滑动的窗口：起点在第一次读这个目录时定下，
+  // 之后只增量读新增字节，早期被过滤掉的行不会再回来。做成滚动窗口就得周期性重扫整段历史，
+  // 那与「不要每 5 秒扫描整个运行史」直接冲突，所以这里如实说明而不是假装它是滚动的。
+  notes.push(
+    skipped > 0
+      ? `面板只读最近 ${opts.sinceDays} 天，起点固定在首次读取那一刻（${entry.sinceIso}）；更早的 ${skipped} 条记录未计入，且不会随「现在」滑动补回。`
+      : `面板只读最近 ${opts.sinceDays} 天，起点固定在首次读取那一刻（${entry.sinceIso}）；这份日志里没有更早的记录被跳过。`,
+  );
+  notes.push(
+    '时间范围随 run 变化需要重启进程或换目录重新首次读取；它不会在面板开着的时候向前滚动。',
+  );
+
+  const base = {
+    hasData: result.hasData,
+    noDataLine: NO_DATA_LINE,
+    generatedAt: result.generatedAt,
+    timezone: result.timezone,
+    dataDirLabel: dirLabel(dataDir),
+    window: {
+      sinceIso: entry.sinceIso,
+      days: opts.sinceDays,
+      skippedBeforeSince: skipped,
+      /** 起点固定于首次读取，不随「现在」滑动。 */
+      startPoint: 'first-read',
+      rolling: false,
+    },
+    source: {
+      ...result.source,
+      runDirs: anomalies.runDirs,
+      missingRunLogs: anomalies.missingRunLogs,
+      /** 上一次刷新真正读了多少新记录；用来核对「刷新不重扫整段历史」。 */
+      lastRead: { ...entry.source.lastRefreshRead },
+      refreshedAt: entry.refreshedAt,
+    },
+    anomalies,
+    notes,
+  };
+
+  if (!result.hasData) {
+    // 没有记录时不产出任何「0 消耗」读数，只交出空数据与数据源状态。
+    return {
+      ...base,
+      scopes: [],
+      sessionScopes: [],
+      minecraftLabel: result.minecraft.label,
+      sessionLabel: SESSION_SCOPE_LABEL,
+      categories: [],
+      reconciliation: result.reconciliation,
+      unclassified: [],
+      rounds: [],
+      roundsOmitted: 0,
+      roundsShown: 0,
+      roundsNewestFirst: result.roundsNewestFirst,
+      roundPageSize: result.roundPageSize,
+      cost: { entries: [], knownCount: 0, unknownCount: 0, text: formatCost(result.cost) },
+    };
+  }
+
+  // 顶部表是 Minecraft 相关轮次汇总（只含三类 MC 轮次）；全会话汇总另列作对照。
+  // 这两套数字必须分开：顶部回答「游戏相关花了多少」，对照组回答「这段时间总共花了多少」。
+  const [mcOverall, mcToday, mcCurrentRun, mcLastHour] = result.minecraft.scopes;
+
+  return {
+    ...base,
+    scopes: [
+      scopeOf('overall', mcOverall),
+      scopeOf('today', mcToday),
+      scopeOf('currentRun', mcCurrentRun),
+      scopeOf('lastHour', mcLastHour),
+    ],
+    /** 顶部表的口径标题，面板直接显示，避免读者误当独占消耗。 */
+    minecraftLabel: result.minecraft.label,
+    /** 全会话对照：含所有分类，不能当作 Minecraft 用量。 */
+    sessionLabel: SESSION_SCOPE_LABEL,
+    sessionScopes: [
+      scopeOf('overall', result.overall),
+      scopeOf('today', result.windows.today),
+      scopeOf('currentRun', result.windows.currentRun),
+      scopeOf('lastHour', result.windows.lastHour),
+    ],
+    categories: result.categories.map((item) => ({
+      key: item.category,
+      label: item.label,
+      count: item.count,
+      share: item.share,
+    })),
+    reconciliation: result.reconciliation,
+    unclassified: result.unclassifiedReasons.map((item) => ({
+      reason: item.reason,
+      label: REASON_TEXT[item.reason] ?? item.reason,
+      count: item.count,
+    })),
+    rounds: result.rounds.map((round) => ({
+      run: round.run,
+      round: round.round,
+      role: round.role,
+      category: round.category,
+      categoryLabel: CATEGORY_LABEL[round.category] ?? round.category,
+      attempts: round.attempts,
+      input: round.input,
+      cached: round.cached,
+      uncached: round.uncached,
+      output: round.output,
+      reasoning: round.reasoning,
+      unknownCache: round.unknownCache,
+      failed: round.failed,
+      models: [...round.models],
+      firstTs: round.firstTs,
+      lastTs: round.lastTs,
+      cacheReconciled: round.cacheReconciled,
+    })),
+    /** 因超出上限未展示的轮次数；显示为 0 时才说明明细是完整的。 */
+    roundsOmitted: result.roundsOmitted,
+    roundsShown: result.roundsShown,
+    /** 明细顺序：最新在最前。分页只在已加载的这批轮次里翻。 */
+    roundsNewestFirst: result.roundsNewestFirst,
+    roundPageSize: result.roundPageSize,
+    cost: { ...result.cost, text: formatCost(result.cost) },
+  };
+}
+
+function scopeOf(key, scope) {
+  return {
+    key,
+    label: scope.label,
+    run: scope.run,
+    attempts: scope.attempts,
+    rounds: scope.rounds,
+    input: scope.input,
+    output: scope.output,
+    cached: scope.cached,
+    uncached: scope.uncached,
+    reasoning: scope.reasoning,
+    unknownUsage: scope.unknownUsage,
+    unknownCache: scope.unknownCache,
+    degraded: scope.degraded,
+    failed: scope.failed,
+    discarded: scope.discarded,
+    cacheMismatch: scope.cacheMismatch,
+    cacheReconciles: scope.cacheReconciles,
+    lastUpdated: scope.lastUpdated,
+    models: [...scope.models],
+    categories: CATEGORY_ORDER.map((category) => ({
+      key: category,
+      label: CATEGORY_LABEL[category],
+      count: scope.categories[category],
+    })),
+  };
+}
diff --git a/src/worlds/minecraft/usage/report.mjs b/src/worlds/minecraft/usage/report.mjs
new file mode 100644
index 0000000..dd558ee
--- /dev/null
+++ b/src/worlds/minecraft/usage/report.mjs
@@ -0,0 +1,162 @@
+/**
+ * 报告格式化。
+ *
+ * 无数据时只输出「暂无数据 / 等待记录」，绝不输出“游戏用量 0”。
+ * 数字里的 null 一律渲染成「未知」，不写成 0。
+ */
+
+import { CATEGORY, CATEGORY_LABEL, CATEGORY_ORDER } from './types.mjs';
+
+const NO_DATA_LINE = '暂无数据 / 等待记录';
+
+/**
+ * 全会话对照组的标题。
+ *
+ * 它不是 Minecraft 用量：里面含全部五类分类（含「其余主会话轮次」「未能归类」），
+ * 只用来回答「同期总共花了多少」，不能拿来当游戏消耗。
+ */
+export const SESSION_SCOPE_LABEL = '全部轮次（对照，含所有分类）';
+
+/** 把聚合结果渲染成给人看的纯文本报告。 */
+export function formatTextReport(result) {
+  const lines = [];
+  lines.push('Minecraft 相关轮次用量');
+  lines.push('='.repeat(48));
+
+  if (!result.hasData) {
+    lines.push('');
+    lines.push(NO_DATA_LINE);
+    lines.push('');
+    lines.push('没有读到任何用量记录。可能还没开过游戏，或日志尚未生成。');
+    lines.push(`数据源：${result.source.records} 条用量记录 / ${result.source.toolCalls} 条工具调用记录。`);
+    lines.push(`口径：整个轮次的请求消耗，不是 Minecraft 独占消耗。时区 ${result.timezone}。`);
+    return lines.join('\n');
+  }
+
+  lines.push(`口径：整个轮次的请求消耗，不是 Minecraft 独占消耗。`);
+  lines.push(`时区：${result.timezone}　生成时间：${result.generatedAt}`);
+  lines.push('');
+
+  // 顶部只报 Minecraft 相关三类轮次；这正是面板首屏要回答的问题。
+  const [mcOverall, mcToday, mcCurrentRun, mcLastHour] = result.minecraft.scopes;
+  lines.push(`— ${result.minecraft.label} —`);
+  lines.push(formatScope(mcOverall, { detailed: true }));
+  lines.push(`  ${formatCost(result.cost)}`);
+  lines.push('');
+
+  for (const scope of [mcToday, mcCurrentRun, mcLastHour]) {
+    lines.push(`— ${scope.label}（Minecraft 相关） —`);
+    lines.push(formatScope(scope, { detailed: false }));
+    lines.push('');
+  }
+
+  // 全会话汇总保留作对照：它含全部五类，不能当作 Minecraft 用量。
+  lines.push(`— ${SESSION_SCOPE_LABEL} —`);
+  lines.push(formatScope(result.overall, { detailed: true }));
+  lines.push(`  ${formatCost(result.cost)}（费用只统计 Minecraft 相关轮次）`);
+  lines.push('');
+  for (const key of ['today', 'currentRun', 'lastHour']) {
+    lines.push(`— ${result.windows[key].label}（全部轮次对照） —`);
+    lines.push(formatScope(result.windows[key], { detailed: false }));
+    lines.push('');
+  }
+
+  lines.push('— 轮次归属 —');
+  for (const item of result.categories) {
+    const share = item.share === null ? '—' : `${(item.share * 100).toFixed(1)}%`;
+    lines.push(`  ${item.label.padEnd(22, '　')} ${String(item.count).padStart(6)}  ${share}`);
+  }
+  const balance = result.reconciliation.balanced ? '✓' : '✗';
+  lines.push(`  ${balance} 五类合计 ${result.reconciliation.classifiedTotal} / 输入 ${result.reconciliation.inputTotal}`);
+  if (result.unclassifiedReasons.length > 0) {
+    lines.push('  未能归类明细：');
+    for (const item of result.unclassifiedReasons) {
+      lines.push(`    ${reasonLabel(item.reason)}：${item.count}`);
+    }
+  }
+  lines.push('');
+
+  if (result.rounds.length > 0) {
+    lines.push('— Minecraft 相关轮次明细（最新在最前） —');
+    lines.push('  run                    round  role    类别      请求  输入    缓存    未缓存  输出   对账');
+    for (const round of result.rounds) {
+      lines.push(
+        '  ' +
+          [
+            String(round.run ?? '—').slice(0, 22).padEnd(22),
+            String(round.round ?? '—').padStart(5),
+            String(round.role ?? '—').padEnd(7),
+            CATEGORY_LABEL[round.category].padEnd(8, '　'),
+            String(round.attempts).padStart(4),
+            formatNumber(round.input).padStart(7),
+            formatNumber(round.cached).padStart(7),
+            formatNumber(round.uncached).padStart(7),
+            formatNumber(round.output).padStart(6),
+            round.cacheReconciled ? '✓' : '未知/不符',
+          ].join(' '),
+      );
+    }
+    // 截断必须写出来：看表的人不能以为这就是全部轮次。
+    if (result.roundsOmitted > 0) {
+      lines.push(
+        `  ⋯ 只列最近 ${result.roundsShown} 个轮次，另有更早的 ${result.roundsOmitted} 个轮次未展示（它们仍计入上面的汇总）。`,
+      );
+    }
+    lines.push('');
+  }
+
+  lines.push('— 数据源 —');
+  lines.push(`  用量记录 ${result.source.records} 条（去重后 ${result.source.dedupedRecords} 条，重复 recordId ${result.source.duplicateRecordIds} 条，缺 recordId ${result.source.noRecordId} 条）`);
+  lines.push(`  工具调用记录 ${result.source.toolCalls} 条`);
+  for (const note of result.notes) lines.push(`  · ${note}`);
+
+  return lines.join('\n');
+}
+
+function formatScope(scope, { detailed }) {
+  const lines = [];
+  if (scope.run !== null) lines.push(`  当前 run：${scope.run}`);
+  lines.push(`  请求 attempt：${scope.attempts}　决策轮次：${scope.rounds}`);
+  lines.push(`  输入 token：${formatNumber(scope.input)}　其中缓存命中：${formatNumber(scope.cached)}　未缓存：${formatNumber(scope.uncached)}`);
+  lines.push(`  输出 token：${formatNumber(scope.output)}（其中 reasoning ${formatNumber(scope.reasoning)}，已含在输出内，不再相加）`);
+  lines.push(`  失败：${scope.failed}　丢弃：${scope.discarded}　用量未知：${scope.unknownUsage}　缓存未知：${scope.unknownCache}`);
+  if (detailed) {
+    lines.push(`  缓存对账：${scope.cacheReconciles ? '✓ 缓存命中+未缓存 = 输入' : '未知或对不上，见说明'}`);
+    lines.push(`  模型：${scope.models.length > 0 ? scope.models.join('、') : '—'}`);
+    lines.push(`  最近更新：${scope.lastUpdated ?? '—'}`);
+    const categoryParts = CATEGORY_ORDER.map(
+      (category) => `${CATEGORY_LABEL[category]} ${scope.categories[category]}`,
+    );
+    lines.push(`  分类：${categoryParts.join('　')}`);
+  }
+  return lines.join('\n');
+}
+
+/** 未知渲染成「未知」，不渲染成 0。 */
+function formatNumber(value) {
+  if (value === null || value === undefined) return '未知';
+  return value.toLocaleString('en-US');
+}
+
+const REASON_TEXT = {
+  'world-self-other': '其他 World 的自报用量（不是 Minecraft）',
+  'no-round': '用量记录缺少 run/round，无法关联轮次',
+  'no-correlation': '工具调用日志里没有这个轮次',
+  'unknown-format': '记录格式无法识别',
+  'role-mismatch': '同一轮次出现在别的 role 下',
+};
+
+function reasonLabel(reason) {
+  return `${REASON_TEXT[reason] ?? reason}（${reason}）`;
+}
+
+/** 报告里的费用区。只有记录本身给出金额与币种时才显示，否则明确写未知。 */
+export function formatCost(cost) {
+  if (cost.entries.length === 0) {
+    return '费用：未知（记录里没有可用的计价信息；免费线路与缓存命中不等于零配额、零成本）';
+  }
+  const parts = cost.entries.map((entry) => `${entry.amount} ${entry.currency}`);
+  return `费用：${parts.join('、')}${cost.unknownCount > 0 ? `（另有 ${cost.unknownCount} 条记录计价未知）` : ''}`;
+}
+
+export { CATEGORY, CATEGORY_LABEL, NO_DATA_LINE, REASON_TEXT };
