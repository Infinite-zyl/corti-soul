+++ b/src/worlds/minecraft/usage/source.mjs
@@ -0,0 +1,248 @@
+/**
+ * 数据源读取。
+ *
+ * 只读部署 dataDir 下的两个固定位置：
+ *   <dataDir>/usage.jsonl
+ *   <dataDir>/runs/<run>/toolcalls.jsonl
+ * 不接受任意路径：run 目录名由磁盘扫描得出，不来自外部输入，也不允许跳出 dataDir。
+ *
+ * 首次读取扫一遍现有文件；之后每次刷新只读新增字节（见 incremental.mjs），
+ * 已读过的记录留在内存里参与聚合，因此刷新不会重扫整段历史。
+ *
+ * **按文件保存贡献**：内存里的记录不是一条无出处的流水，而是挂在各自文件上的一组贡献。
+ * 文件被截断或替换时，先撤掉这个文件先前贡献的全部记录，再用重读出来的内容重建，
+ * 否则旧记录会留成幽灵、截断掉的内容也不会消失。普通追加只增不改。
+ */
+
+import { readdir } from 'node:fs/promises';
+import { join, resolve, sep } from 'node:path';
+import { JsonlFileState } from './incremental.mjs';
+import { epochOf, projectToolCall } from './types.mjs';
+
+export const USAGE_FILENAME = 'usage.jsonl';
+export const RUNS_DIRNAME = 'runs';
+export const TOOLCALLS_FILENAME = 'toolcalls.jsonl';
+
+/** 数据源状态：累积的记录、每个文件的读取游标、异常计数。 */
+export class UsageSource {
+  /**
+   * @param {string} dataDir 部署 data 目录
+   * @param {object} [options]
+   * @param {string|number|Date} [options.since] 首次读取时只保留这个时刻之后的记录；
+   *   更早的记录直接丢弃，不进内存。JSONL 没有索引，首读仍要从头扫一遍字节，
+   *   之后每次刷新只读新增字节。
+   */
+  constructor(dataDir, options = {}) {
+    this.dataDir = resolve(dataDir);
+    this.usageFile = join(this.dataDir, USAGE_FILENAME);
+    this.runsDir = join(this.dataDir, RUNS_DIRNAME);
+    this.usageState = new JsonlFileState(this.usageFile);
+    this.sinceMs = options.since === undefined || options.since === null ? null : epochOf(options.since);
+    /** run 名 → JsonlFileState */
+    this.runStates = new Map();
+    /**
+     * 文件路径 → 这个文件贡献的记录数组（与 this.records / this.toolCalls 里是同一批对象引用）。
+     * 文件被截断或替换时整组撤掉再重建；普通追加只往组尾推。
+     */
+    this.usageContrib = [];
+    this.runContribs = new Map();
+    this.records = [];
+    this.toolCalls = [];
+    this.anomalies = {
+      badLines: 0,
+      truncations: 0,
+      /** 因文件被截断或替换而撤销旧贡献、改用当前内容重建的次数。 */
+      rebuilds: 0,
+      missingUsage: false,
+      missingRunsDir: false,
+      unreadable: 0,
+      /** run 目录存在但 toolcalls.jsonl 不在的个数。 */
+      missingRunLogs: 0,
+      /** 因早于 since 而被首读丢弃的记录数。 */
+      skippedBeforeSince: 0,
+      /** 出现的 run 目录总数，便于报告说明覆盖范围。 */
+      runDirs: 0,
+    };
+    this.lastRefreshRead = { usage: 0, toolCalls: 0, files: 0, rebuilds: 0 };
+  }
+
+  /**
+   * 刷新一次。
+   *
+   * 只读新增字节。返回本次新增的记录数，便于测试断言“刷新不重扫”。
+   */
+  async refresh() {
+    this.lastRefreshRead = { usage: 0, toolCalls: 0, files: 0, rebuilds: 0 };
+
+    const newUsage = await this.usageState.read();
+    if (this.usageState.lastReadReset) {
+      // 截断或替换：先撤掉这个文件先前贡献的全部记录，再用当前内容重建。
+      this.dropUsageContribution();
+      this.anomalies.rebuilds += 1;
+      this.lastRefreshRead.rebuilds += 1;
+    }
+    // 首读按时间范围过滤：早于 since 的记录不参与聚合，也不留在内存里。
+    // 过滤只作用于 usage；工具调用按轮次关联，早期轮次的记录被丢掉后自然不会再被引用。
+    for (const record of newUsage) {
+      if (this.sinceMs === null || !this.isBeforeSince(record)) {
+        this.records.push(record);
+        this.usageContrib.push(record);
+        this.lastRefreshRead.usage += 1;
+      } else {
+        this.anomalies.skippedBeforeSince += 1;
+      }
+    }
+
+    let runNames;
+    try {
+      const entries = await readdir(this.runsDir, { withFileTypes: true });
+      runNames = entries.filter((entry) => entry.isDirectory()).map((entry) => entry.name);
+    } catch (error) {
+      if (error.code === 'ENOENT') {
+        this.anomalies.missingRunsDir = true;
+        runNames = [];
+      } else {
+        this.anomalies.unreadable += 1;
+        runNames = [];
+      }
+    }
+    this.anomalies.runDirs = runNames.length;
+
+    for (const runName of runNames) {
+      const path = this.runPathFor(runName);
+      if (path === null) continue; // 目录名不合法，跳过，不越界读文件。
+      let state = this.runStates.get(path);
+      if (state === undefined) {
+        state = new JsonlFileState(path);
+        this.runStates.set(path, state);
+      }
+      const entries = await state.read();
+      if (state.lastReadReset) {
+        // 同一个 run 的工具日志被截断或换掉：撤掉它先前贡献的调用，避免旧工具污染轮次归属。
+        this.dropRunContribution(path);
+        this.anomalies.rebuilds += 1;
+        this.lastRefreshRead.rebuilds += 1;
+      }
+      if (entries.length === 0) continue;
+      this.lastRefreshRead.files += 1;
+      this.lastRefreshRead.toolCalls += entries.length;
+      let contrib = this.runContribs.get(path);
+      if (contrib === undefined) {
+        contrib = [];
+        this.runContribs.set(path, contrib);
+      }
+      // 只保留允许的元数据字段；args/receipt 在这一步就被丢掉。
+      for (const entry of entries) {
+        const projected = projectToolCall(entry);
+        this.toolCalls.push(projected);
+        contrib.push(projected);
+      }
+    }
+
+    this.recomputeAnomalies();
+    return this.lastRefreshRead;
+  }
+
+  /** 撤掉 usage.jsonl 先前贡献的记录，从内存里整组移除。 */
+  dropUsageContribution() {
+    if (this.usageContrib.length === 0) return;
+    const drop = new Set(this.usageContrib);
+    this.records = this.records.filter((record) => !drop.has(record));
+    this.usageContrib = [];
+  }
+
+  /** 撤掉某个 run 的工具日志先前贡献的调用。 */
+  dropRunContribution(path) {
+    const contrib = this.runContribs.get(path);
+    if (contrib === undefined || contrib.length === 0) {
+      this.runContribs.set(path, []);
+      return;
+    }
+    const drop = new Set(contrib);
+    this.toolCalls = this.toolCalls.filter((entry) => !drop.has(entry));
+    this.runContribs.set(path, []);
+  }
+
+  /**
+   * run 目录名 → toolcalls.jsonl 路径。
+   *
+   * 解析后的路径必须仍在 runs 目录内，否则返回 null。目录名来自磁盘枚举，
+   * 这里仍做一次越界检查，避免任何形式的路径穿越。
+   */
+  runPathFor(runName) {
+    if (typeof runName !== 'string' || runName === '' || runName === '.' || runName === '..') return null;
+    if (runName.includes('/') || runName.includes('\\')) return null;
+    const path = resolve(this.runsDir, runName, TOOLCALLS_FILENAME);
+    const prefix = this.runsDir + sep;
+    if (!path.startsWith(prefix)) return null;
+    return path;
+  }
+
+  /**
+   * 该记录是否早于 since。
+   *
+   * ts 缺失或无法解析时不算早——宁可多算，不静默丢掉一条读不懂的记录。
+   */
+  isBeforeSince(record) {
+    if (this.sinceMs === null) return false;
+    const ts = typeof record.ts === 'string' ? epochOf(record.ts) : null;
+    if (ts === null) return false;
+    return ts < this.sinceMs;
+  }
+
+  recomputeAnomalies() {
+    let badLines = this.usageState.anomalies.badLines;
+    let truncations = this.usageState.anomalies.truncations;
+    let unreadableRuns = 0;
+    let missingRunLogs = 0;
+    for (const state of this.runStates.values()) {
+      badLines += state.anomalies.badLines;
+      truncations += state.anomalies.truncations;
+      if (state.anomalies.unreadable) unreadableRuns += 1;
+      if (state.anomalies.missing) missingRunLogs += 1;
+    }
+    this.anomalies.badLines = badLines;
+    this.anomalies.truncations = truncations;
+    this.anomalies.missingUsage = this.usageState.anomalies.missing;
+    this.anomalies.unreadableRuns = unreadableRuns;
+    this.anomalies.missingRunLogs = missingRunLogs;
+  }
+
+  /** 未消费完的尾部行数（说明最后一行还没写完）。 */
+  get partialLines() {
+    let count = this.usageState.hasPartialLine ? 1 : 0;
+    for (const state of this.runStates.values()) if (state.hasPartialLine) count += 1;
+    return count;
+  }
+
+  /** 报告用的数据源异常摘要。 */
+  get anomalySummary() {
+    return {
+      badLines: this.anomalies.badLines,
+      truncations: this.anomalies.truncations,
+      /** 因截断或替换而撤销旧贡献、改用当前内容重建的次数。 */
+      rebuilds: this.anomalies.rebuilds ?? 0,
+      missingUsage: this.anomalies.missingUsage,
+      missingRunsDir: this.anomalies.missingRunsDir,
+      unreadableRuns: this.anomalies.unreadableRuns ?? 0,
+      missingRunLogs: this.anomalies.missingRunLogs ?? 0,
+      skippedBeforeSince: this.anomalies.skippedBeforeSince,
+      runDirs: this.anomalies.runDirs,
+      partialLines: this.partialLines,
+    };
+  }
+}
+
+/** 从环境变量解析部署 dataDir，只接受显式给出的目录。 */
+export function resolveDataDir(env = process.env) {
+  if (typeof env.CORTICO_DATA_DIR === 'string' && env.CORTICO_DATA_DIR !== '') {
+    return resolve(env.CORTICO_DATA_DIR);
+  }
+  const root = typeof env.CORTICO_ROOT === 'string' && env.CORTICO_ROOT !== ''
+    ? resolve(env.CORTICO_ROOT)
+    : resolve(process.cwd(), '..', 'cortico-qq');
+  const deployment = typeof env.DEPLOY_NAME === 'string' && env.DEPLOY_NAME !== ''
+    ? env.DEPLOY_NAME
+    : 'mybot';
+  return resolve(root, 'deployments', deployment, 'data');
+}
diff --git a/src/worlds/minecraft/usage/timeline-state.mjs b/src/worlds/minecraft/usage/timeline-state.mjs
