+/**
+ * 连不上的那半小时里每一轮重连失败都是同一件事的复述。重复投递只会把同一句话
+ * 堆满上下文，所以只第一次说清，之后只写本地诊断。连上再断才算新的一次。
+ */
+describe('MinecraftWorld 断线通知只投递一次', () => {
+  interface Priv {
+    bridge: { bot?: unknown; opts: { onDisconnect?: (reason: string, willReconnect: boolean, attempt: number) => void } } | null;
+    linkDownNotified: boolean;
+    diag: { after(seq: number): Array<{ lane: string; event: string; msg: string }> };
+  }
+
+  /** 走真的 start()：bridge 的 onDisconnect 由 World 的装配逻辑挂上，不手搓回调。 */
+  async function rig(): Promise<{ m: MinecraftWorld; host: FakeHost; priv: Priv; fire: (reason: string, attempt: number) => void }> {
+    const m = new MinecraftWorld({ cfg: cfg() });
+    const host = new FakeHost();
+    await m.start(host as never);
+    await vi.advanceTimersByTimeAsync(0);
+    const priv = m as unknown as Priv;
+    const cb = priv.bridge?.opts.onDisconnect;
+    expect(typeof cb).toBe('function');
+    // onSpawn 第一行就要 bot，没有就直接返回；真 Bridge 的 bot 是只读 getter，
+    // 所以换成带 opts 与假 bot 的替身，回调仍是 World 装配时挂上的那一个。
+    // idleBot 是普通对象，onSpawn 一路会挂事件监听，所以补上 EventEmitter 的那几个口。
+    const bot = Object.assign(new EventEmitter(), idleBot() as Record<string, unknown>);
+    stub(m, {
+      bridge: {
+        bot, connected: true, invSynced: true, active: true,
+        opts: priv.bridge!.opts,
+        stop: async () => {},
+      },
+    });
+    return { m, host, priv, fire: (reason, attempt) => cb!(reason, true, attempt) };
+  }
+
+  it('连续多次重连失败只投递第一条断线事件，其余只进本地诊断', async () => {
+    vi.useFakeTimers();
+    vi.spyOn(Bridge.prototype, 'start').mockImplementation(() => undefined);
+    vi.spyOn(Bridge.prototype, 'stop').mockResolvedValue(undefined);
+    try {
+      const { m, host, priv, fire } = await rig();
+
+      fire('socketClosed', 0);
+      fire('socketClosed', 1);
+      fire('socketClosed', 2);
+
+      const link = host.events.filter((e) => e.text.includes('与服务器断开'));
+      expect(link).toHaveLength(1);
+      expect(link[0].text).toContain('不再反复叫醒你');
+
+      // 复述只进本地诊断，一条不少
+      const repeats = priv.diag.after(0).filter((e) => e.event === 'disconnect-repeat');
+      expect(repeats).toHaveLength(2);
+      expect(repeats[1].msg).toContain('第 3 次仍未连上');
+
+      // 真的连上再断才算新的一次
+      (m as unknown as { onSpawn(): void }).onSpawn();
+      expect(priv.linkDownNotified).toBe(false);
+      fire('socketClosed', 0);
+      expect(host.events.filter((e) => e.text.includes('与服务器断开'))).toHaveLength(2);
+
+      await m.stop();
+    } finally {
+      vi.restoreAllMocks();
+      vi.useRealTimers();
+    }
+  });
+});
