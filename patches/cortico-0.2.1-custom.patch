+/**
+ * 「动作时间线」面板：当前 run 里她在什么时间做了什么、为什么失败、哪些调用重复。
+ *
+ * 两个来源分开列：模型工具调用（`mc_do` / `mc_queue` / `mc_bag` …）与执行器边界事件
+ * （受理 / 开工 / 每步开始 / 每步结局 / 叫停 / 预检）。一次 `mc_do` 只表示模型下过这条令，
+ * 队列里每一步做没做成功看执行器事件；有开始而没有配对到结束的步骤显示「未结束」，不当成功。
+ *
+ * 数据全部来自服务端 `state` 方法，本文件只画。只读，不调模型、不发消息、不写文件。
+ */
+
+import type {
+  WebUiPanelContext,
+  WebUiPanel,
+} from '../../../web/shared/client-panel.ts';
+
+const DESC =
+  '当前 run 的动作时间线：工具调用与执行器事件分开列，最新在最前。数据来自部署数据目录'
+  + '里的工具调用日志与 Minecraft 诊断日志，只读；面板刷新不调用模型、不发消息、不写任何文件。';
+const POLL_MS = 5000;
+
+/** 一条时间线条目。`status` 由服务端给出，面板不自己推断。 */
+interface TimelineEntry {
+  key: string;
+  at: string;
+  seq: number | null;
+  run: string;
+  round: number | null;
+  source: 'tool' | 'executor';
+  scope: 'call' | 'step' | 'task';
+  tool: string;
+  event: string;
+  phase: string;
+  status: string;
+  taskId: number | null;
+  stepIndex: number | null;
+  action: string;
+  detail: string;
+  durMs: number | null;
+  callId: string;
+  unfinished: boolean;
+}
+
+interface TimelineStats {
+  scope: string;
+  run: string;
+  toolCalls: {
+    total: number;
+    byTool: Array<{ tool: string; count: number }>;
+  };
+  steps: {
+    begin: number;
+    ok: number;
+    blocked: number;
+    aborted: number;
+    cancelled: number;
+    skipped: number;
+    noop: number;
+    unfinished: number;
+  };
+  taskEvents: {
+    enqueue: number;
+    start: number;
+    done: number;
+    blocked: number;
+    cancelled: number;
+    cleared: number;
+    suspended: number;
+    precheck: number;
+  };
+  repeats: Array<{ tool: string; action: string; count: number }>;
+}
+
+export interface MinecraftTimelineState {
+  hasData: boolean;
+  noDataLine: string;
+  generatedAt: string;
+  timezone: string;
+  dataDirLabel: string;
+  run: string;
+  source: {
+    run: string;
+    runDirs: number;
+    missingRunsDir: boolean;
+    missingToolCalls: boolean;
+    missingLog: boolean;
+    skippedEvents: number;
+    badLines: number;
+    truncations: number;
+    lastRead: { run: string; toolCalls: number; events: number; rebuilds: number };
+    refreshedAt: number;
+  };
+  anomalies: {
+    missingRunsDir: boolean;
+    missingLog: boolean;
+    missingToolCalls: boolean;
+    skippedEvents: number;
+    badLines: number;
+    truncations: number;
+  };
+  notes: string[];
+  entries: TimelineEntry[];
+  /** 超出上限未展示的条数；为 0 时列表覆盖整个 run。 */
+  omitted: number;
+  total: number;
+  maxEntries: number;
+  pageSize: number;
+  newestFirst: boolean;
+  stats: TimelineStats;
+}
+
+/** 状态文案。未知一律写「未知」，不写成功。 */
+const STATUS_ZH: Record<string, string> = {
+  call: '已下指令',
+  queued: '已受理',
+  started: '已开工',
+  ok: '成功',
+  blocked: '受阻',
+  aborted: '中断',
+  cancelled: '取消',
+  skipped: '跳过',
+  noop: '无事可做',
+  cleared: '已清空',
+  precheck: '预检',
+  suspended: '挂起',
+  preempted: '被抢占',
+  unfinished: '未结束',
+  unknown: '未知',
+};
+
+function statusText(entry: TimelineEntry): string {
+  return STATUS_ZH[entry.status] ?? '未知';
+}
+
+function num(value: number | null | undefined): string {
+  if (value === null || value === undefined) return '未知';
+  return value.toLocaleString('en-US');
+}
+
+function msText(ms: number | null): string {
+  if (ms === null || !Number.isFinite(ms)) return '—';
+  if (ms < 1000) return `${ms}ms`;
+  if (ms < 60_000) return `${(ms / 1000).toFixed(1)}s`;
+  const minutes = Math.floor(ms / 60_000);
+  return `${minutes}m${String(Math.round((ms % 60_000) / 1000)).padStart(2, '0')}s`;
+}
+
+/** 来源列：工具调用写工具名，执行器事件写事件名。 */
+function sourceText(entry: TimelineEntry): string {
+  return entry.source === 'tool' ? `工具 ${entry.tool}` : `执行器 ${entry.event}`;
+}
+
+export const timelinePanel: WebUiPanel = {
+  mount(ctx: WebUiPanelContext) {
+    const { ui, root } = ctx;
+    const card = ui.foldSheet('timeline', { title: '动作时间线', en: 'action timeline', desc: DESC });
+    const body = card.body;
+    root.appendChild(card.el);
+
+    const msg = ui.msgline('');
+    body.appendChild(msg);
+
+    const statTable = ui.table({ head: ['当前 run 工具次数', '次数'] });
+    const stepTable = ui.table({ head: ['步骤结局', '条数'] });
+    const taskTable = ui.table({ head: ['任务事件', '条数'] });
+    const repeatTable = ui.table({ head: ['重复调用', '动作', '次数'] });
+    const entryTable = ui.table({
+      head: ['时间', 'run', '轮次', '来源', '任务/步', '动作摘要', '状态', '结果', '耗时'],
+      maxHeight: 'calc(100vh - 420px)',
+    });
+
+    const pageBar = ui.actions();
+    const btnPrev = ui.button('← 上一页', { size: 'sm' });
+    const btnNext = ui.button('下一页 →', { size: 'sm' });
+    const pageLabel = ui.h('span', 'mc-dim');
+    const frozenLabel = ui.h('span', 'mc-dim');
+    const btnLatest = ui.button('查看最新', { size: 'sm', variant: 'primary' });
+    pageBar.append(btnPrev, pageLabel, btnNext, ui.h('span', 'grow'), frozenLabel, btnLatest);
+    const entryNote = ui.h('div', 'mc-para mc-dim');
+    const sourceTable = ui.table();
+
+    body.appendChild(ui.section('当前 run 统计', '口径是完整当前 run，不是列表里那几百条'));
+    body.appendChild(statTable.el);
+    body.appendChild(stepTable.el);
+    body.appendChild(taskTable.el);
+    body.appendChild(ui.section('重复调用', '同名同参的调用次数；按调用 ID 去重，不按名字合并'));
+    body.appendChild(repeatTable.el);
+    body.appendChild(ui.section('时间线', '最新在最前；工具调用与执行器事件分开标注'));
+    body.appendChild(entryTable.el);
+    body.appendChild(pageBar);
+    body.appendChild(entryNote);
+    body.appendChild(ui.section('数据源', '读取位置与文件状态'));
+    body.appendChild(sourceTable.el);
+    const noteList = ui.h('div', 'mc-para mc-dim');
+    body.appendChild(noteList);
+
+    /** 最近一次拿到的状态。翻页只重画，不重新取数。 */
+    let lastState: MinecraftTimelineState | null = null;
+    let page = 1;
+    /** 翻到第 2 页起把列表冻住：轮询会往最前面插新条目，不冻的话同一行会往下串。 */
+    let frozenEntries: TimelineEntry[] | null = null;
+
+    btnPrev.addEventListener('click', () => {
+      if (page > 1) { page -= 1; redraw(); }
+    }, { signal: ctx.signal });
+    btnNext.addEventListener('click', () => {
+      if (lastState === null || lastState.entries.length === 0) return;
+      if (frozenEntries === null) frozenEntries = lastState.entries;
+      const size = Math.max(1, Math.floor(lastState.pageSize) || 25);
+      const pageCount = Math.max(1, Math.ceil(frozenEntries.length / size));
+      if (page < pageCount) { page += 1; redraw(); }
+    }, { signal: ctx.signal });
+    btnLatest.addEventListener('click', () => {
+      frozenEntries = null;
+      page = 1;
+      redraw();
+    }, { signal: ctx.signal });
+
+    const render = (state: MinecraftTimelineState | null): void => {
+      if (state !== null && lastState !== null && state.run !== lastState.run) {
+        frozenEntries = null;
+        page = 1;
+      }
+      lastState = state;
+      if (frozenEntries === null) page = 1;
+      paint(state);
+    };
+
+    const redraw = (): void => {
+      paint(lastState);
+    };
+
+    const paint = (state: MinecraftTimelineState | null): void => {
+      if (ctx.signal.aborted) return;
+      statTable.clear();
+      stepTable.clear();
+      taskTable.clear();
+      repeatTable.clear();
+      entryTable.clear();
+      sourceTable.clear();
+      entryNote.replaceChildren();
+      noteList.replaceChildren();
+
+      if (state === null) {
+        card.note.textContent = '读取失败';
+        msg.textContent = '读不到动作日志，下一拍再试。';
+        msg.classList.add('bad');
+        entryTable.clear('暂无数据');
+        pageBar.hidden = true;
+        return;
+      }
+
+      card.note.textContent = state.hasData
+        ? `${state.dataDirLabel}　刷新 ${ui.fmt.clock(state.generatedAt)}`
+        : '暂无数据';
+      msg.textContent = '';
+      msg.classList.remove('bad');
+
+      if (!state.hasData) {
+        entryTable.clear(state.noDataLine);
+        pageBar.hidden = true;
+        sourceTable.addRow(['数据目录', state.dataDirLabel]);
+        sourceTable.addRow(['当前 run', state.source.run === '' ? '还没读到 run 目录' : state.source.run]);
+        sourceTable.addRow(['文件状态', sourceStatus(state)]);
+        fillNotes(state);
+        return;
+      }
+
+      for (const item of state.stats.toolCalls.byTool) {
+        statTable.addRow([item.tool, num(item.count)]);
+      }
+      statTable.addRow([
+        { text: '工具调用合计', cls: 'mono' },
+        num(state.stats.toolCalls.total),
+      ]);
+
+      const steps = state.stats.steps;
+      stepTable.addRow(['步骤开始', num(steps.begin)]);
+      stepTable.addRow(['成功', num(steps.ok)]);
+      stepTable.addRow(['受阻', num(steps.blocked)]);
+      stepTable.addRow(['中断', num(steps.aborted)]);
+      stepTable.addRow(['取消', num(steps.cancelled)]);
+      stepTable.addRow(['跳过', num(steps.skipped)]);
+      stepTable.addRow(['无事可做', num(steps.noop)]);
+      // 未结束单独一行：有开始没配对到结束，不能并进「成功」。
+      stepTable.addRow([
+        { text: '未结束（有开始，没有结束事件）', cls: 'mono' },
+        num(steps.unfinished),
+      ]);
+
+      const tasks = state.stats.taskEvents;
+      taskTable.addRow(['受理', num(tasks.enqueue)]);
+      taskTable.addRow(['开工', num(tasks.start)]);
+      taskTable.addRow(['整单完成', num(tasks.done)]);
+      taskTable.addRow(['整单受阻', num(tasks.blocked)]);
+      taskTable.addRow(['整单取消', num(tasks.cancelled)]);
+      taskTable.addRow(['清空', num(tasks.cleared)]);
+      taskTable.addRow(['挂起 / 被抢占', num(tasks.suspended)]);
+      taskTable.addRow(['预检', num(tasks.precheck)]);
+
+      if (state.stats.repeats.length === 0) {
+        repeatTable.clear('没有重复的调用');
+      } else {
+        for (const item of state.stats.repeats) {
+          repeatTable.addRow([item.tool, item.action === '' ? '—' : item.action, num(item.count)]);
+        }
+      }
+
+      if (state.entries.length === 0) {
+        entryTable.clear('这个 run 还没有动作记录');
+        pageBar.hidden = true;
+      } else {
+        const size = Math.max(1, Math.floor(state.pageSize) || 25);
+        const list = frozenEntries ?? state.entries;
+        const pageCount = Math.max(1, Math.ceil(list.length / size));
+        if (page > pageCount) page = pageCount;
+        if (page < 1) page = 1;
+        const from = (page - 1) * size;
+        const rows = list.slice(from, from + size);
+        for (const entry of rows) {
+          const where = entry.scope === 'task'
+            ? (entry.taskId === null ? '整单' : `任务#${entry.taskId}`)
+            : (entry.taskId === null ? '—' : `任务#${entry.taskId}`);
+          entryTable.addRow([
+            ui.fmt.clock(entry.at),
+            entry.run === '' ? '—' : entry.run,
+            entry.round === null ? '—' : String(entry.round),
+            sourceText(entry),
+            where,
+            entry.action === '' ? '—' : entry.action,
+            {
+              text: statusText(entry),
+              cls: entry.status === 'ok' ? 'mono' : 'txt',
+            },
+            entry.detail === '' ? '—' : entry.detail,
+            msText(entry.durMs),
+          ]);
+        }
+        pageBar.hidden = false;
+        btnPrev.disabled = page <= 1;
+        btnNext.disabled = page >= pageCount;
+        pageLabel.textContent =
+          `第 ${num(page)} / ${num(pageCount)} 页 · 本页 ${num(rows.length)} 条 · 可浏览 ${num(list.length)} 条`;
+        frozenLabel.textContent = frozenEntries === null ? '' : '列表已冻结，不随刷新变化';
+        const parts: string[] = [];
+        parts.push(
+          state.omitted > 0
+            ? `⋯ 时间线最多保留最近 ${num(state.maxEntries)} 条，另有更早的 ${num(state.omitted)} 条未展示`
+              + `（未展示的翻不到，但它们仍计入上面的统计）。`
+            : `⋯ 已展示全部 ${num(state.total)} 条。`,
+        );
+        if (frozenEntries !== null) parts.push('列表已冻结，点「查看最新」回到最新。');
+        entryNote.textContent = parts.join(' ');
+      }
+
+      sourceTable.addRow(['数据目录', state.dataDirLabel]);
+      sourceTable.addRow(['当前 run', state.source.run === '' ? '—' : state.source.run]);
+      sourceTable.addRow([
+        '上次刷新新读',
+        `工具调用 ${num(state.source.lastRead.toolCalls)} 条、执行器事件 ${num(state.source.lastRead.events)} 条`
+          + `${state.source.lastRead.rebuilds > 0 ? `；重建 ${num(state.source.lastRead.rebuilds)} 次` : ''}`,
+      ]);
+      sourceTable.addRow(['时区', state.timezone]);
+      sourceTable.addRow(['文件状态', sourceStatus(state)]);
+      fillNotes(state);
+    };
+
+    const fillNotes = (state: MinecraftTimelineState): void => {
+      for (const line of state.notes) noteList.appendChild(ui.h('div', null, line));
+    };
+
+    const poll = (): void => {
+      if (polling) return;
+      polling = true;
+      void ctx.invoke<MinecraftTimelineState>('state').then(
+        (state) => {
+          polling = false;
+          first = false;
+          render(state ?? null);
+        },
+        (err: unknown) => {
+          polling = false;
+          if (ctx.signal.aborted) return;
+          const bad = err instanceof Error ? err.message : String(err);
+          if (first) render(null);
+          msg.textContent = bad;
+          msg.classList.add('bad');
+        },
+      );
+    };
+    let polling = false;
+    let first = true;
+
+    entryTable.clear('正在读取…');
+    msg.textContent = '正在读取…';
+    ctx.interval(poll, POLL_MS);
+    poll();
+  },
+};
+
+function sourceStatus(state: MinecraftTimelineState): string {
+  const parts: string[] = [];
+  const a = state.anomalies;
+  if (a.missingRunsDir) parts.push('运行日志目录不在');
+  if (a.missingToolCalls) parts.push('工具调用日志不在');
+  if (a.missingLog) parts.push('诊断日志不在（只剩工具调用那一半）');
+  if (a.badLines > 0) parts.push(`坏行 ${a.badLines} 条`);
+  if (a.truncations > 0) parts.push(`日志截断重读 ${a.truncations} 次`);
+  if (a.skippedEvents > 0) parts.push(`${a.skippedEvents} 条日志不是执行器边界事件，未进时间线`);
+  if (parts.length === 0) return '正常';
+  return parts.join('；');
+}
diff --git a/src/worlds/minecraft/webui/usage.ts b/src/worlds/minecraft/webui/usage.ts
new file mode 100644
index 0000000..d1bee50
