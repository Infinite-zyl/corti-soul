+++ b/src/worlds/minecraft/webui/usage.ts
@@ -0,0 +1,458 @@
+/**
+ * 「Minecraft 相关轮次用量」面板：只读展示本 World 相关轮次的请求消耗。
+ *
+ * 口径：统计的是**整个轮次**的请求消耗，不是 Minecraft 独占消耗；reasoning 通常已含在
+ * output 内，只单列不再相加；缓存属于输入，命中 + 未缓存应与输入相当，对不上或读不到时
+ * 显示「未知」而不是 0。
+ *
+ * 首屏那张表只含 Minecraft 相关三类轮次，回答「游戏相关花了多少」；全会话汇总另起一张
+ * 表作对照，回答「同期总共花了多少」。两张表的数字不能互相替代，标题由服务端给出。
+ * 数据全部来自服务端 `state` 方法，本文件只画。
+ */
+
+import type {
+  WebUiPanelContext,
+  WebUiPanel,
+} from '../../../web/shared/client-panel.ts';
+
+const DESC =
+  '整个轮次的请求消耗，不是 Minecraft 独占消耗。数据来自部署数据目录里的用量日志与'
+  + '工具调用日志，只读；面板刷新不调用模型、不发消息、不写任何文件。';
+const POLL_MS = 5000;
+
+/** 一个范围的读数。服务端把 null 留成 null，这里渲染成「未知」。 */
+interface UsageScopeState {
+  key: string;
+  label: string;
+  run: string | null;
+  attempts: number;
+  rounds: number;
+  input: number;
+  output: number;
+  cached: number;
+  uncached: number;
+  reasoning: number;
+  unknownUsage: number;
+  unknownCache: number;
+  degraded: number;
+  failed: number;
+  discarded: number;
+  cacheMismatch: number;
+  cacheReconciles: boolean;
+  lastUpdated: string | null;
+  models: string[];
+  categories: Array<{ key: string; label: string; count: number }>;
+}
+
+interface UsageCategoryRow {
+  key: string;
+  label: string;
+  count: number;
+  share: number | null;
+}
+
+interface UsageRoundRow {
+  run: string | null;
+  round: number | null;
+  role: string | null;
+  categoryLabel: string;
+  attempts: number;
+  input: number;
+  cached: number | null;
+  uncached: number | null;
+  output: number;
+  reasoning: number;
+  unknownCache: number;
+  failed: number;
+  models: string[];
+  lastTs: string | null;
+  cacheReconciled: boolean;
+}
+
+export interface MinecraftUsageState {
+  hasData: boolean;
+  noDataLine: string;
+  generatedAt: string;
+  timezone: string;
+  dataDirLabel: string;
+  window: {
+    sinceIso: string;
+    days: number;
+    skippedBeforeSince: number;
+    /** 起点固定在首次读取那一刻，不随「现在」滑动。 */
+    startPoint: string;
+    rolling: boolean;
+  };
+  source: {
+    records: number;
+    dedupedRecords: number;
+    duplicateRecordIds: number;
+    noRecordId: number;
+    toolCalls: number;
+    runDirs: number;
+    missingRunLogs: number;
+    lastRead: { usage: number; toolCalls: number; files: number; rebuilds: number };
+    refreshedAt: number;
+  };
+  anomalies: {
+    badLines: number;
+    truncations: number;
+    /** 日志被截断或替换后撤销旧贡献、按当前内容重建的次数。 */
+    rebuilds: number;
+    missingUsage: boolean;
+    missingRunsDir: boolean;
+    unreadableRuns: number;
+    missingRunLogs: number;
+    partialLines: number;
+    runDirs: number;
+  };
+  notes: string[];
+  /** 首屏表：只含 Minecraft 相关三类轮次。 */
+  scopes: UsageScopeState[];
+  /** 顶部表的口径标题，由服务端给出。 */
+  minecraftLabel: string;
+  /** 全会话对照表的标题。 */
+  sessionLabel: string;
+  /** 全会话对照：含全部五类分类，不能当作 Minecraft 用量。 */
+  sessionScopes: UsageScopeState[];
+  categories: UsageCategoryRow[];
+  reconciliation: { classifiedTotal: number; inputTotal: number; balanced: boolean };
+  unclassified: Array<{ reason: string; label: string; count: number }>;
+  rounds: UsageRoundRow[];
+  /** 超出上限未展示的轮次数；为 0 时明细才是完整的。 */
+  roundsOmitted: number;
+  roundsShown: number;
+  /** 明细顺序：最新在最前。分页只在已加载的这批轮次里翻。 */
+  roundsNewestFirst: boolean;
+  /** 明细每页条数，由服务端给出。 */
+  roundPageSize: number;
+  cost: { entries: Array<{ currency: string; amount: number }>; knownCount: number; unknownCount: number; text: string };
+}
+
+/** 未知就写「未知」，不写 0；`ui.fmt.count` 会把空值渲染成破折号并把数字缩写，这里不适用。 */
+function num(value: number | null | undefined): string {
+  if (value === null || value === undefined) return '未知';
+  return value.toLocaleString('en-US');
+}
+
+function shareText(share: number | null): string {
+  return share === null ? '未知' : `${(share * 100).toFixed(1)}%`;
+}
+
+function modelText(models: readonly string[]): string {
+  return models.length > 0 ? models.join('、') : '—';
+}
+
+/** 范围表的一行。首屏表与对照表列相同，只有数据源不同。 */
+function scopeRow(scope: UsageScopeState): Array<string> {
+  return [
+    scope.run === null ? scope.label : `${scope.label} ${scope.run}`,
+    num(scope.attempts),
+    num(scope.rounds),
+    num(scope.input),
+    num(scope.cached),
+    num(scope.uncached),
+    num(scope.output),
+    num(scope.reasoning),
+    num(scope.failed),
+    num(scope.discarded),
+    num(scope.unknownUsage),
+    num(scope.unknownCache),
+  ];
+}
+
+/** `ui.section` 的标题节点。取不到时返回 null，调用方保留静态标题。 */
+function headTitle(section: HTMLElement): HTMLElement | null {
+  return section.querySelector('h4');
+}
+
+export const usagePanel: WebUiPanel = {
+  mount(ctx: WebUiPanelContext) {
+    const { ui, root } = ctx;
+    const card = ui.foldSheet('usage', { title: 'Minecraft 相关轮次用量', en: 'related-round usage', desc: DESC });
+    const body = card.body;
+    root.appendChild(card.el);
+
+    const msg = ui.msgline('');
+    body.appendChild(msg);
+
+    /** 范围读数表：三个时间窗口加总览。首屏表只含 Minecraft 相关轮次。 */
+    const scopeTable = ui.table({
+      head: ['范围', '请求 attempt', '决策轮次', '输入 token', '缓存命中', '未缓存', '输出 token', '推理 token', '失败', '丢弃', '用量未知', '缓存未知'],
+    });
+    const sessionTable = ui.table({
+      head: ['范围', '请求 attempt', '决策轮次', '输入 token', '缓存命中', '未缓存', '输出 token', '推理 token', '失败', '丢弃', '用量未知', '缓存未知'],
+    });
+    const categoryTable = ui.table({ head: ['类别', '条数', '占比'] });
+    const modelTable = ui.table({ head: ['范围', '模型'] });
+    const roundTable = ui.table({
+      head: ['run', '轮次', 'role', '类别', 'attempt', '输入', '缓存命中', '未缓存', '输出', '推理', '缓存未知', '失败', '模型', '缓存对账', '最近一次'],
+    });
+    // 轮次明细分页控件。分页只作用于服务端已加载的那批轮次（默认最多 200 条），
+    // 翻不到更早的历史——这一点由 roundNote 与页码标签同时说清，不能让读者以为能翻完全部。
+    const roundBar = ui.actions();
+    const btnPrev = ui.button('← 上一页', { size: 'sm' });
+    const btnNext = ui.button('下一页 →', { size: 'sm' });
+    const pageLabel = ui.h('span', 'mc-dim');
+    const frozenLabel = ui.h('span', 'mc-dim');
+    const btnLatest = ui.button('查看最新', { size: 'sm', variant: 'primary' });
+    roundBar.append(btnPrev, pageLabel, btnNext, ui.h('span', 'grow'), frozenLabel, btnLatest);
+    const sourceTable = ui.table();
+
+    // 标题由服务端给出：口径（整轮计入、非独占）属于数据面，面板不自己编一句可能不一致的话。
+    const scopeHead = ui.section('Minecraft 相关轮次', '整轮计入，非独占');
+    const sessionHead = ui.section('全部轮次对照', '含所有分类，不是 Minecraft 用量');
+    const roundNote = ui.h('div', 'mc-para mc-dim');
+    body.appendChild(scopeHead);
+    body.appendChild(scopeTable.el);
+    body.appendChild(sessionHead);
+    body.appendChild(sessionTable.el);
+    body.appendChild(ui.section('分类覆盖率', '五类互斥，合计应与去重后的记录数一致'));
+    body.appendChild(categoryTable.el);
+    body.appendChild(ui.section('模型', '上面两张表里出现过的模型'));
+    body.appendChild(modelTable.el);
+    body.appendChild(ui.section('轮次明细', '含 Minecraft 自有调用、混合操作、含 Minecraft 操作的轮次；最新在最前'));
+    body.appendChild(roundTable.el);
+    body.appendChild(roundBar);
+    body.appendChild(roundNote);
+    body.appendChild(ui.section('数据源', '读取位置、时间范围与文件状态'));
+    body.appendChild(sourceTable.el);
+    // 说明文字：一行口径一句，保留换行（复用现有的 mc-para/mc-dim，不新增样式）。
+    const noteList = ui.h('div', 'mc-para mc-dim');
+    body.appendChild(noteList);
+
+    let first = true;
+    /** 最近一次拿到的状态。翻页与「查看最新」只重画，不重新取数。 */
+    let lastState: MinecraftUsageState | null = null;
+    /** 当前页码，从 1 开始。第 1 页显示最新，自动刷新直接反映新轮次。 */
+    let page = 1;
+    /**
+     * 用户翻到第 2 页起，把当时的列表冻住。轮询每 5 秒会往最前面插新轮次，不冻的话
+     * 同一行会往下串：翻页时看到重复或漏读。「查看最新」解冻并回到第 1 页。
+     */
+    let frozenRounds: UsageRoundRow[] | null = null;
+
+    btnPrev.addEventListener('click', () => {
+      if (page > 1) { page -= 1; redraw(); }
+    }, { signal: ctx.signal });
+    btnNext.addEventListener('click', () => {
+      if (lastState === null || lastState.rounds.length === 0) return;
+      // 第一次离开第 1 页时冻结列表，之后再翻都在同一份快照里。
+      if (frozenRounds === null) frozenRounds = lastState.rounds;
+      const size = Math.max(1, Math.floor(lastState.roundPageSize) || 25);
+      const pageCount = Math.max(1, Math.ceil(frozenRounds.length / size));
+      if (page < pageCount) { page += 1; redraw(); }
+    }, { signal: ctx.signal });
+    btnLatest.addEventListener('click', () => {
+      frozenRounds = null;
+      page = 1;
+      redraw();
+    }, { signal: ctx.signal });
+
+    const render = (state: MinecraftUsageState | null): void => {
+      lastState = state;
+      // 停在第 1 页时列表不冻，新轮次照常出现在顶部；翻过页就保持那份快照。
+      if (frozenRounds === null) page = 1;
+      paint(state);
+    };
+
+    const redraw = (): void => {
+      paint(lastState);
+    };
+
+    const paint = (state: MinecraftUsageState | null): void => {
+      if (ctx.signal.aborted) return;
+      scopeTable.clear();
+      sessionTable.clear();
+      categoryTable.clear();
+      modelTable.clear();
+      roundTable.clear();
+      sourceTable.clear();
+      roundNote.replaceChildren();
+      noteList.replaceChildren();
+
+      if (state === null) {
+        card.note.textContent = '读取失败';
+        msg.textContent = '读不到用量记录，下一拍再试。';
+        msg.classList.add('bad');
+        scopeTable.clear('暂无数据');
+        // 读不到数就没有可翻的页，分页条不能停在上一拍的状态上。
+        roundBar.hidden = true;
+        return;
+      }
+
+      card.note.textContent = state.hasData
+        ? `${state.dataDirLabel}　刷新 ${ui.fmt.clock(state.generatedAt)}`
+        : '暂无数据';
+      msg.textContent = '';
+      msg.classList.remove('bad');
+
+      if (!state.hasData) {
+        // 没有记录时只说明在等待，不印任何 0——「游戏消耗 0」会读成没有消耗。
+        scopeTable.clear(state.noDataLine);
+        sessionTable.clear(state.noDataLine);
+        roundBar.hidden = true;
+        sourceTable.addRow(['数据目录', state.dataDirLabel]);
+        sourceTable.addRow(['时间范围', windowText(state)]);
+        sourceTable.addRow(['用量日志', state.anomalies.missingUsage ? '还没有这个文件' : '存在但还没有可用的记录']);
+        fillNotes(state);
+        return;
+      }
+
+      // 表头用服务端给的口径标题，面板不自造：两套数字的差别只能由数据面定义。
+      const mcTitle = headTitle(scopeHead);
+      if (mcTitle !== null) mcTitle.textContent = state.minecraftLabel;
+      const sessionTitle = headTitle(sessionHead);
+      if (sessionTitle !== null) sessionTitle.textContent = state.sessionLabel;
+
+      for (const scope of state.scopes) scopeTable.addRow(scopeRow(scope));
