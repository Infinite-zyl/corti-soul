@@ -0,0 +1,238 @@
+/**
+ * Minecraft 用量面板的数据契约与投影。
+ *
+ * 输入只有两个文件：deployments/<部署>/data/usage.jsonl 与 data/runs/<run>/toolcalls.jsonl。
+ * ToolCallEntry 只读 seq/run/round/role/resp/call/tool/mod/ts；args 与 receipt 在读取时就被丢弃，
+ * 不进入聚合器内存，也不进报告。
+ */
+
+/** 面板时间口径。usage.jsonl 的 ts 已带 +08:00 偏移，分日仍按部署时区判定。 */
+export const TIMEZONE = 'Asia/Shanghai';
+
+/** 关联键字段。同一个 round 只在同一个 run 内成立，不跨 run 复用。 */
+export const CORRELATION_FIELDS = ['run', 'round', 'role'];
+
+/** ToolCallEntry 允许进入聚合器的字段。 */
+export const TOOLCALL_FIELDS = ['seq', 'run', 'round', 'role', 'resp', 'call', 'tool', 'mod', 'ts'];
+
+/** 面板的五类归属，顺序与任务书一致。 */
+export const CATEGORY = {
+  /** 1 Minecraft 自有模型调用（World 自报）。 */
+  WORLD_SELF: 'world-self',
+  /** 2 main 轮次同时含 Minecraft 工具与其他 World 工具。 */
+  MIXED: 'mixed',
+  /** 3 main 轮次含 Minecraft 工具，未检测到其他 World 工具。 */
+  MC_ROUND: 'mc-round',
+  /** 4 可关联但没有 Minecraft 工具的 main 轮次。 */
+  OTHER_MAIN: 'other-main',
+  /** 5 关联键/日志缺失、未知格式。单列，不丢弃，不猜测。 */
+  UNCLASSIFIED: 'unclassified',
+};
+
+export const CATEGORY_ORDER = [
+  CATEGORY.WORLD_SELF,
+  CATEGORY.MIXED,
+  CATEGORY.MC_ROUND,
+  CATEGORY.OTHER_MAIN,
+  CATEGORY.UNCLASSIFIED,
+];
+
+/** 归属的中文标签。 */
+export const CATEGORY_LABEL = {
+  [CATEGORY.WORLD_SELF]: 'Minecraft 自有调用',
+  [CATEGORY.MIXED]: '混合操作轮次',
+  [CATEGORY.MC_ROUND]: '含 Minecraft 操作的轮次',
+  [CATEGORY.OTHER_MAIN]: '其余主会话轮次',
+  [CATEGORY.UNCLASSIFIED]: '未能归类',
+};
+
+/** 未能归类的原因码。报告按原因单列，不做推测性归并。 */
+export const REASON = {
+  /** role/sessionId 是别的 World 的自报用量，没有 round，不属于 Minecraft。 */
+  WORLD_SELF_OTHER: 'world-self-other',
+  /** 用量记录没有 round，无法与任何轮次关联。 */
+  NO_ROUND: 'no-round',
+  /** 有 round，但 toolcalls 里找不到同一 (run, round, role) 的轮次。 */
+  NO_CORRELATION: 'no-correlation',
+  /** JSON 可解析，但不具备任何 UsageRecord 字段，形态无法识别。 */
+  UNKNOWN_FORMAT: 'unknown-format',
+  /** 同一 (run, round) 出现在多个 role 下，无法判定归属。 */
+  ROLE_MISMATCH: 'role-mismatch',
+};
+
+/** 具备任一字段就认为这是一条 UsageRecord，而不是别的什么东西。 */
+const USAGE_SHAPE_FIELDS = [
+  'recordId', 'attempt', 'version', 'model', 'sessionId', 'role', 'ts',
+  'promptTokens', 'completionTokens', 'cacheHitTokens', 'cacheMissTokens', 'reasoningTokens',
+];
+
+/** 该对象是否长得像一条 UsageRecord。 */
+export function looksLikeUsageRecord(record) {
+  if (record === null || typeof record !== 'object' || Array.isArray(record)) return false;
+  return USAGE_SHAPE_FIELDS.some((field) => record[field] !== undefined);
+}
+
+/** Minecraft 工具的判定：优先看 mod，旧日志缺 mod 时按确认过的 mc_ 前缀降级识别。 */
+export const MC_MOD = 'minecraft';
+export const MC_TOOL_PREFIX = 'mc_';
+
+/**
+ * Minecraft World 的自报用量 role/sessionId。
+ * core.ts 用 `worlds.<WorldId>` 打开自报 session，所以这里就是 World id 的前缀形式。
+ */
+export const MC_WORLD_SELF_IDS = ['worlds.minecraft'];
+
+/**
+ * 旧日志缺 mod 时的降级前缀表：只认确认过的 World 工具前缀。
+ * Persona 文件工具（read_file/end_turn/save_blob 等）没有前缀，不在表内，因此不算其他 World。
+ */
+export const WORLD_TOOL_PREFIXES = {
+  qq_: 'qq',
+  mem_: 'memory',
+  people_: 'qqbot',
+  affinity_: 'affinity',
+  life_: 'life',
+  learn_: 'learn',
+  gaming_: 'gaming',
+  terminal_: 'terminal',
+};
+
+/** 关联键。round 与 run 一起构成，避免两个 run 的 round=1 串账。 */
+export function correlationKey(run, round, role) {
+  return `${run}\u0000${round}\u0000${role}`;
+}
+
+/** 只保留允许的元数据字段；args/receipt/durMs/chars/blobs 在这里被丢掉。 */
+export function projectToolCall(raw) {
+  const out = {};
+  for (const field of TOOLCALL_FIELDS) {
+    if (raw[field] !== undefined) out[field] = raw[field];
+  }
+  return out;
+}
+
+/** 该工具调用是否属于 Minecraft。 */
+export function isMinecraftTool(entry) {
+  if (entry.mod === MC_MOD) return true;
+  return typeof entry.tool === 'string' && entry.tool.startsWith(MC_TOOL_PREFIX);
+}
+
+/** 该工具调用属于哪个其他 World；Persona 工具返回 null。 */
+export function otherWorldOf(entry) {
+  if (entry.mod !== undefined && entry.mod !== null && entry.mod !== '') {
+    return entry.mod === MC_MOD ? null : String(entry.mod);
+  }
+  const tool = typeof entry.tool === 'string' ? entry.tool : '';
+  for (const [prefix, world] of Object.entries(WORLD_TOOL_PREFIXES)) {
+    if (tool.startsWith(prefix)) return world;
+  }
+  return null;
+}
+
+/** 该用量记录是否是某个 World 的自报用量，是则返回 `worlds.<id>`。 */
+export function worldSelfIdOf(record) {
+  const role = typeof record.role === 'string' ? record.role : '';
+  const sessionId = typeof record.sessionId === 'string' ? record.sessionId : '';
+  for (const value of [role, sessionId]) {
+    if (value.startsWith('worlds.')) return value;
+  }
+  return null;
+}
+
+/** `YYYY-MM-DD`，按给定时区的本地日期。无法解析返回 null。 */
+export function localDateKey(ts, timezone = TIMEZONE) {
+  const date = new Date(ts);
+  if (Number.isNaN(date.getTime())) return null;
+  const parts = new Intl.DateTimeFormat('en-CA', {
+    timeZone: timezone, year: 'numeric', month: '2-digit', day: '2-digit',
+  }).formatToParts(date);
+  const read = (type) => parts.find((part) => part.type === type)?.value;
+  return `${read('year')}-${read('month')}-${read('day')}`;
+}
+
+/** 毫秒时间戳；无法解析返回 null。 */
+export function epochOf(ts) {
+  const value = new Date(ts).getTime();
+  return Number.isNaN(value) ? null : value;
+}
+
+/**
+ * 单个用量记录的仪表读数。
+ *
+ * v2 优先用 attempt.meters 的原始仪表：null 表示未知，不当零。
+ * 缓存对账状态：
+ *   reconciled —— cached + uncached === input
+ *   derived    —— 缺 uncached，但 input 与 cached 都在，可由 input - cached 得出
+ *   mismatch   —— 三者都在但对不上，单独标记
+ *   unknown    —— 任一项为 null，不猜
+ * 没有 attempt 的旧记录只能用兼容数值字段，其中缓存字段可能把未知写成 0，因此记 degraded。
+ */
+export function readMeters(record) {
+  const attempt = record.attempt;
+  if (attempt && typeof attempt === 'object') {
+    const meters = attempt.meters;
+    if (meters && typeof meters === 'object') {
+      return readV2Meters(meters);
+    }
+    // v2 但仪表整体缺失：读数未知，不退回兼容字段（那些字段把未知写成了 0）。
+    return {
+      source: 'meters',
+      input: null,
+      output: null,
+      cached: null,
+      uncached: null,
+      reasoning: null,
+      cacheState: 'unknown',
+      degraded: false,
+    };
+  }
+  // 旧格式：没有 attempt 对象，只能用兼容数值字段。
+  const input = numberOrNull(record.promptTokens);
+  const output = numberOrNull(record.completionTokens);
+  return {
+    source: 'compat-fields',
+    input,
+    output,
+    // 兼容数值字段把未知写成 0，这里不作数：缓存一律记未知，并计 degraded。
+    cached: null,
+    uncached: null,
+    reasoning: null,
+    cacheState: 'unknown',
+    degraded: true,
+  };
+}
+
+function readV2Meters(meters) {
+  const input = numberOrNull(meters.input);
+  const output = numberOrNull(meters.output);
+  const cached = numberOrNull(meters.cachedInput);
+  const rawUncached = numberOrNull(meters.uncachedInput);
+
+  let uncached = rawUncached;
+  let cacheState;
+  if (cached === null || input === null) {
+    cacheState = 'unknown';
+  } else if (rawUncached === null) {
+    uncached = input - cached;
+    cacheState = 'derived';
+  } else if (cached + rawUncached === input) {
+    cacheState = 'reconciled';
+  } else {
+    cacheState = 'mismatch';
+  }
+
+  return {
+    source: 'meters',
+    input,
+    output,
+    cached,
+    uncached,
+    reasoning: numberOrNull(meters.reasoning),
+    cacheState,
+    degraded: false,
+  };
+}
+
+function numberOrNull(value) {
+  return typeof value === 'number' && Number.isFinite(value) ? value : null;
+}
