diff --git a/tests/worlds/minecraft/reconnect-budget.test.ts b/tests/worlds/minecraft/reconnect-budget.test.ts
new file mode 100644
index 0000000..7c2cfec
--- /dev/null
+++ b/tests/worlds/minecraft/reconnect-budget.test.ts
@@ -0,0 +1,270 @@
+/**
+ * 自动重连预算的契约。
+ *
+ * 这些用例直接驱动状态机与可控时钟：断言的是「还能不能连」这件事本身，
+ * 不是某个常量被读了几次。核心是**握手成功不等于稳定在线**——连上即断的抖动
+ * 必须不能刷新预算，否则预算永远用不完。
+ */
+import { describe, expect, it } from 'vitest';
+import {
+  ReconnectBudget, RECONNECT_BUDGET_DEFAULTS, isPermanentFailure,
+} from '../../../src/worlds/minecraft/reconnect-budget.ts';
+
+/** 固定一份预算，避免用例跟着默认值漂。 */
+function budgetOf(overrides: Partial<typeof RECONNECT_BUDGET_DEFAULTS> = {}): ReconnectBudget {
+  const opts = { ...RECONNECT_BUDGET_DEFAULTS, ...overrides };
+  return new ReconnectBudget(() => opts);
+}
+
+/** 走完整个退避阶梯，把预算用满并进入暂停。 */
+function exhaust(budget: ReconnectBudget): void {
+  for (let i = 0; i < RECONNECT_BUDGET_DEFAULTS.maxRetries; i++) budget.failed('socketClosed', i);
+  budget.failed('socketClosed', 99);
+}
+
+describe('重连预算：退避阶梯与上限', () => {
+  it('默认阶梯是 10/30/60 秒，三次用满之后进入暂停', () => {
+    const budget = budgetOf();
+    expect(budget.failed('socketClosed', 1_000)).toBe(10_000);
+    expect(budget.failed('socketClosed', 2_000)).toBe(30_000);
+    expect(budget.failed('socketClosed', 3_000)).toBe(60_000);
+    expect(budget.phase).toBe('waiting');
+    // 第四次没有下一次了：暂停，而不是继续按 60 秒排下去。
+    expect(budget.failed('socketClosed', 4_000)).toBeNull();
+    expect(budget.phase).toBe('paused');
+    expect(budget.remaining).toBe(0);
+  });
+
+  it('退避封顶在 maxDelaySec：把上限调小不会让间隔无限涨', () => {
+    const budget = budgetOf({ maxRetries: 6, baseDelaySec: 10, maxDelaySec: 20 });
+    expect(budget.failed('x', 0)).toBe(10_000);
+    expect(budget.failed('x', 0)).toBe(20_000);
+    expect(budget.failed('x', 0)).toBe(20_000);
+  });
+
+  it('maxRetries = 0 表示第一次失败就暂停，不排任何重试', () => {
+    const budget = budgetOf({ maxRetries: 0 });
+    expect(budget.failed('socketClosed', 0)).toBeNull();
+    expect(budget.phase).toBe('paused');
+  });
+
+  it('非法配置退回默认值，不因为一份坏配置把预算关掉', () => {
+    const budget = new ReconnectBudget(() => ({ maxRetries: -5, baseDelaySec: Number.NaN, maxDelaySec: 0 }));
+    expect(budget.remaining).toBe(RECONNECT_BUDGET_DEFAULTS.maxRetries);
+    expect(budget.failed('x', 0)).toBe(RECONNECT_BUDGET_DEFAULTS.baseDelaySec * 1000);
+  });
+});
+
+describe('重连预算：稳定在线才清零', () => {
+  it('握手成功不清零：connected 只记起点，预算原样保留', () => {
+    const budget = budgetOf();
+    budget.failed('x', 1_000);
+    budget.failed('x', 2_000);
+    expect(budget.usedRetries).toBe(2);
+    budget.connected(10_000);
+    // 连上了，但还没到稳定阈值：已经用掉的两次重试不能被抹掉。
+    expect(budget.usedRetries).toBe(2);
+    expect(budget.confirmStable(10_000)).toBe(false);
+    expect(budget.usedRetries).toBe(2);
+    expect(budget.lastSuccessAtMs).toBeNull();
+  });
+
+  it('连满 stableSec 才清零：到点那一刻才记下最后成功时间', () => {
+    const budget = budgetOf({ stableSec: 60 });
+    budget.failed('x', 0);
+    budget.connected(10_000);
+    // 差一秒都不算稳定
+    expect(budget.confirmStable(10_000 + 59_999)).toBe(false);
+    expect(budget.usedRetries).toBe(1);
+    // 满 60 秒才算，此时才清零
+    expect(budget.confirmStable(10_000 + 60_000)).toBe(true);
+    expect(budget.usedRetries).toBe(0);
+    expect(budget.phase).toBe('ready');
+    expect(budget.lastSuccessAtMs).toBe(10_000 + 60_000);
+  });
+
+  it('连上即断的抖动不能无限刷新预算：反复短连最终仍然暂停', () => {
+    const budget = budgetOf({ stableSec: 60 });
+    let now = 0;
+    // 模拟「连上 5 秒就被踢」重复很多轮：每一轮都握手成功，但都不到稳定阈值。
+    for (let i = 0; i < 20; i++) {
+      budget.connected(now);
+      now += 5_000; // 只在线 5 秒
+      expect(budget.confirmStable(now)).toBe(false); // 心跳里问一次：还不稳定
+      const delay = budget.failed('socketClosed', now);
+      now += delay ?? 0;
+      if (delay === null) break;
+    }
+    // 20 轮短连之后必须已经暂停——这正是旧实现（spawn 即清零）做不到的。
+    expect(budget.phase).toBe('paused');
+    expect(budget.usedRetries).toBe(RECONNECT_BUDGET_DEFAULTS.maxRetries);
+  });
+
+  it('暂停之后稳定在线也能解除：连满阈值就不该继续停在暂停', () => {
+    const budget = budgetOf({ maxRetries: 1, stableSec: 30 });
+    exhaust(budget);
+    expect(budget.phase).toBe('paused');
+    budget.connected(1_000);
+    expect(budget.confirmStable(1_000 + 30_000)).toBe(true);
+    expect(budget.phase).toBe('ready');
+    expect(budget.usedRetries).toBe(0);
+  });
+
+  it('断线作废稳定窗口：下一次握手要重新计时', () => {
+    const budget = budgetOf({ stableSec: 60 });
+    budget.connected(0);
+    budget.disconnected();
+    expect(budget.uptimeMs(120_000)).toBeNull();
+    expect(budget.isStable(120_000)).toBe(false);
+    budget.connected(120_000);
+    expect(budget.confirmStable(120_000 + 59_000)).toBe(false);
+    expect(budget.confirmStable(120_000 + 60_000)).toBe(true);
+  });
+
+  it('failed 自己也会作废稳定窗口：失败之后不能靠旧起点立刻算稳定', () => {
+    const budget = budgetOf({ stableSec: 60 });
+    budget.connected(0);
+    budget.failed('socketClosed', 61_000); // 本来已经在线够久了
+    // 失败已经作废了窗口，所以现在不算稳定
+    expect(budget.isStable(62_000)).toBe(false);
+    expect(budget.confirmStable(62_000)).toBe(false);
+  });
+
+  it('stableSec = 0 表示一连上就算稳定', () => {
+    const budget = budgetOf({ stableSec: 0 });
+    budget.failed('x', 0);
+    budget.connected(5_000);
+    expect(budget.confirmStable(5_000)).toBe(true);
+    expect(budget.usedRetries).toBe(0);
+  });
+});
+
+describe('重连预算：稳定确认是每条连接一次的状态转换', () => {
+  it('同一条稳定连接反复确认只成功一次，且不再刷新最后成功时间', () => {
+    const budget = budgetOf({ stableSec: 60 });
+    budget.failed('x', 0);
+    budget.connected(1_000);
+    const stableAt = 1_000 + 60_000;
+    expect(budget.confirmStable(stableAt)).toBe(true);
+    expect(budget.lastSuccessAtMs).toBe(stableAt);
+    // 心跳每秒问一次：后面每一次都必须是 false，否则调用方每秒重放一遍副作用，
+    // 而且 lastSuccessAtMs 会被刷成「现在」，看起来像刚刚才连上。
+    for (let t = stableAt + 1_000; t <= stableAt + 10_000; t += 1_000) {
+      expect(budget.confirmStable(t)).toBe(false);
+    }
+    expect(budget.lastSuccessAtMs).toBe(stableAt);
+  });
+
+  it('稳定状态本身不受一次性确认影响：stable 查询一直如实', () => {
+    const budget = budgetOf({ stableSec: 60 });
+    budget.connected(0);
+    expect(budget.isStable(59_999)).toBe(false);
+    expect(budget.confirmStable(60_000)).toBe(true);
+    // 已经确认过，但「当前确实稳定在线」这个事实不变——面板要能一直读到真值。
+    expect(budget.isStable(60_000)).toBe(true);
+    expect(budget.isStable(600_000)).toBe(true);
+    expect(budget.confirmStable(600_000)).toBe(false);
+    expect(budget.isStable(600_000)).toBe(true);
+  });
+
+  it('断开重连之后可以再次确认一次', () => {
+    const budget = budgetOf({ stableSec: 60 });
+    budget.connected(0);
+    expect(budget.confirmStable(60_000)).toBe(true);
+    expect(budget.confirmStable(120_000)).toBe(false);
+    // 断线作废：新连接重新计时，满了再确认一次
+    budget.disconnected();
+    budget.connected(200_000);
+    expect(budget.confirmStable(200_000 + 59_000)).toBe(false);
+    expect(budget.confirmStable(200_000 + 60_000)).toBe(true);
+    expect(budget.lastSuccessAtMs).toBe(200_000 + 60_000);
+  });
+
+  it('failed 之后这条连接的一次性确认作废，重连能再确认', () => {
+    const budget = budgetOf({ stableSec: 60, maxRetries: 3 });
+    budget.connected(0);
+    expect(budget.confirmStable(60_000)).toBe(true);
+    budget.failed('socketClosed', 61_000);
+    budget.connected(70_000);
+    expect(budget.confirmStable(70_000 + 60_000)).toBe(true);
+  });
+
+  it('resume 之后一次性确认复位，新一轮能重新确认', () => {
+    const budget = budgetOf({ stableSec: 60 });
+    budget.connected(0);
+    expect(budget.confirmStable(60_000)).toBe(true);
+    budget.resume();
+    budget.connected(100_000);
+    expect(budget.confirmStable(100_000 + 60_000)).toBe(true);
+  });
+
+  it('短连抖动仍然刷不回来：一次性确认不会让每轮短连都算稳定', () => {
+    const budget = budgetOf({ stableSec: 60 });
+    let now = 0;
+    for (let i = 0; i < 20; i++) {
+      budget.connected(now);
+      now += 5_000;
+      // 每次心跳都问：短连永远到不了阈值，一次都不会成功
+      expect(budget.confirmStable(now)).toBe(false);
+      expect(budget.confirmStable(now + 1)).toBe(false);
+      const delay = budget.failed('socketClosed', now);
+      now += delay ?? 0;
+      if (delay === null) break;
+    }
+    expect(budget.phase).toBe('paused');
+    expect(budget.usedRetries).toBe(RECONNECT_BUDGET_DEFAULTS.maxRetries);
+    expect(budget.lastSuccessAtMs).toBeNull();
+  });
+
+  it('稳定阈值刚好到点只算一次：同毫秒重复调用第二次为 false', () => {
+    const budget = budgetOf({ stableSec: 30 });
+    budget.connected(0);
+    expect(budget.confirmStable(30_000)).toBe(true);
+    expect(budget.confirmStable(30_000)).toBe(false);
+    expect(budget.lastSuccessAtMs).toBe(30_000);
+  });
+});
+
+describe('重连预算：resume 与不可重试', () => {
+  it('resume 是明确的新一轮：预算归零，但不动「最后成功时间」', () => {
+    const budget = budgetOf({ maxRetries: 1 });
+    budget.connected(1_000);
+    budget.confirmStable(1_000 + RECONNECT_BUDGET_DEFAULTS.stableSec * 1000);
+    expect(budget.lastSuccessAtMs).toBe(1_000 + RECONNECT_BUDGET_DEFAULTS.stableSec * 1000);
+    budget.failed('x', 2_000);
+    budget.failed('x', 3_000);
+    expect(budget.phase).toBe('paused');
+    budget.resume();
+    expect(budget.phase).toBe('ready');
+    expect(budget.usedRetries).toBe(0);
+    expect(budget.lastSuccessAtMs).toBe(1_000 + RECONNECT_BUDGET_DEFAULTS.stableSec * 1000);
+    // 旧连接已经作废，恢复之后要重新计时
+    expect(budget.isStable(9_999_999)).toBe(false);
+  });
+
+  it('认证失败与协议不兼容一次都不重试，直接暂停', () => {
+    for (const reason of [
+      'Unsupported protocol version',
+      'Invalid credentials',
+      'kicked: {"translate":"multiplayer.disconnect.banned"}',
+      'Incompatible client! Please use 1.20.6',
+    ]) {
+      const budget = budgetOf();
+      expect(isPermanentFailure(reason)).toBe(true);
+      expect(budget.failed(reason, 0)).toBeNull();
+      expect(budget.phase).toBe('paused');
+      // 预算一次都没用掉：暂停的原因是「重试没用」，不是「用满了」。
+      expect(budget.usedRetries).toBe(0);
+      expect(budget.pauseInfo().permanent).toBe(true);
+    }
+  });
+
+  it('普通的连接失败不算不可重试，照常走退避', () => {
+    for (const reason of ['socketClosed', 'connect ECONNREFUSED 127.0.0.1:25565', 'read ECONNRESET']) {
+      const budget = budgetOf();
+      expect(isPermanentFailure(reason)).toBe(false);
+      expect(budget.failed(reason, 0)).not.toBeNull();
+      expect(budget.phase).toBe('waiting');
+    }
+  });
+});
